<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SnapDoc.Models"
             x:Class="SnapDoc.Controls.CalendarView"
             x:DataType="models:CalendarViewModel">

    <Grid RowDefinitions="Auto, Auto, *">
        <!-- Monatsname Header mit Navigation -->
        <Grid Grid.Row="0" 
              ColumnDefinitions="Auto, *, Auto" 
              VerticalOptions="Center">

            <!-- Pfeil links (Vorheriger Monat) -->
            <Button Grid.Column="0"
                    Text="‹"
                    FontSize="26"
                    FontAttributes="Bold"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light={DynamicResource PrimaryText}, Dark={DynamicResource PrimaryDarkText}}"
                    Padding="8,0"
                    MinimumWidthRequest="40"
                    MinimumHeightRequest="40"
                    Clicked="OnPreviousMonthClicked" />

            <!-- Monatsname zentriert in der Mitte -->
            <Label Grid.Column="1" 
                   Text="{Binding MonthName}" 
                   FontSize="18" 
                   FontAttributes="Bold"
                   HorizontalOptions="Center" 
                   VerticalOptions="Center" />

            <!-- Pfeil rechts (Naechster Monat) -->
            <Button Grid.Column="2"
                    Text="›"
                    FontSize="26"
                    FontAttributes="Bold"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light={DynamicResource PrimaryText}, Dark={DynamicResource PrimaryDarkText}}"
                    Padding="8,0"
                    MinimumWidthRequest="40"
                    MinimumHeightRequest="40"
                    Clicked="OnNextMonthClicked" />
        </Grid>

        <!-- Kopfzeile: Wochentage -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*,*,*" Margin="0,0,0,0">
            <Label Grid.Column="0" Text="Mo" HorizontalOptions="Center" TextColor="Gray" FontSize="12" />
            <Label Grid.Column="1" Text="Di" HorizontalOptions="Center" TextColor="Gray" FontSize="12" />
            <Label Grid.Column="2" Text="Mi" HorizontalOptions="Center" TextColor="Gray" FontSize="12" />
            <Label Grid.Column="3" Text="Do" HorizontalOptions="Center" TextColor="Gray" FontSize="12" />
            <Label Grid.Column="4" Text="Fr" HorizontalOptions="Center" TextColor="Gray" FontSize="12" />
            <Label Grid.Column="5" Text="Sa" HorizontalOptions="Center" TextColor="Gray" FontSize="12" />
            <Label Grid.Column="6" Text="So" HorizontalOptions="Center" TextColor="Gray" FontSize="12" />
        </Grid>

        <!-- Das Raster -->
        <CollectionView Grid.Row="2"
                HorizontalOptions="Fill"
                ItemsSource="{Binding Days}"
                SelectionMode="None">

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" 
                         Span="7" 
                         HorizontalItemSpacing="0" 
                         VerticalItemSpacing="0" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CalendarDay">
                    <Border Stroke="Transparent"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 22"
                    Padding="0"
                    Margin="0"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    HeightRequest="44">

                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                <Setter Property="BackgroundColor" Value="Transparent" />
                            </DataTrigger>
                        </Border.Triggers>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDayTapped" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <Grid HorizontalOptions="Fill" VerticalOptions="Fill">
                            <Label Text="{Binding DayNumber}"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Fill"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsCurrentMonth}" Value="False">
                                        <Setter Property="Opacity" Value="0.4" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsCurrentMonth}" Value="True">
                                        <Setter Property="Opacity" Value="1.0" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="TextColor" Value="White" />
                                        <Setter Property="FontAttributes" Value="Bold" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={DynamicResource PrimaryText}, Dark={DynamicResource PrimaryDarkText}}" />
                                        <Setter Property="FontAttributes" Value="None" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentView>