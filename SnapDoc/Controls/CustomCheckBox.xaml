<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SnapDoc.Controls"
             x:Class="SnapDoc.Controls.CustomCheckBox"
             x:Name="this"
             x:DataType="controls:CustomCheckBox">

    <Grid ColumnDefinitions="Auto,*"
          ColumnSpacing="{Binding Spacing, Source={x:Reference this}}"
          Padding="{Binding ControlPadding, Source={x:Reference this}}">

        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Grid.GestureRecognizers>

        <!-- Runde Box -->
        <Border x:Name="BoxBorder"
                WidthRequest="{Binding BoxSize, Source={x:Reference this}}"
                HeightRequest="{Binding BoxSize, Source={x:Reference this}}"
                StrokeThickness="{Binding BorderThickness, Source={x:Reference this}}"
                VerticalOptions="Center"
                HorizontalOptions="Start"
                Padding="0">
            <Border.StrokeShape>
                <RoundRectangle x:Name="BoxShape" />
            </Border.StrokeShape>

            <!-- Häkchen -->
            <Label x:Name="GlyphLabel"
                   Text="{x:Static local:MaterialIcons.Check}"
                   FontFamily="MaterialOutlined"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Opacity="0" />
        </Border>

        <!-- Beschriftung -->
        <Label x:Name="TextLabel"
               Grid.Column="1"
               Text="{Binding Text, Source={x:Reference this}}"
               TextColor="{Binding TextColor, Source={x:Reference this}}"
               FontSize="{Binding FontSize, Source={x:Reference this}}"
               FontFamily="{Binding FontFamily, Source={x:Reference this}}"
               LineBreakMode="WordWrap"
               VerticalOptions="Center" />
    </Grid>
</ContentView>
