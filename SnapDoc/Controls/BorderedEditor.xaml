<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SnapDoc"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="SnapDoc.Controls.BorderedEditor"
             x:Name="this">

    <Grid Padding="0,8,0,4">
        <skia:SKCanvasView x:Name="BorderCanvas"
                           PaintSurface="OnPaintSurface"
                           IgnorePixelScaling="False"
                           Margin="0" />

        <local:BorderlessEditor x:Name="InnerEditor"
                               Text="{Binding Text, Source={x:Reference this}, Mode=TwoWay}"
                               TextColor="{Binding TextColor, Source={x:Reference this}}"
                               FontSize="{Binding FontSize, Source={x:Reference this}}"
                               FontFamily="{Binding FontFamily, Source={x:Reference this}}"
                               Keyboard="{Binding Keyboard, Source={x:Reference this}}"
                               AutoSize="TextChanges"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center"
                               Margin="16,12"
                               Focused="InnerEditor_Focused"
                               Unfocused="InnerEditor_Unfocused"
                               TextChanged="InnerEditor_TextChanged"
                               SizeChanged="InnerEditor_SizeChanged" />

        <Label x:Name="FloatingLabel"
               Text="{Binding Placeholder, Source={x:Reference this}}"
               TextColor="{Binding PlaceholderColor, Source={x:Reference this}}"
               FontSize="{Binding FontSize, Source={x:Reference this}}"
               FontFamily="{Binding FontFamily, Source={x:Reference this}}"
               BackgroundColor="Transparent"               
               HorizontalOptions="Start"
               VerticalOptions="Start"
               Margin="10,11,0,0"
               Padding="8,0"
               AnchorX="0"
               InputTransparent="True" />
    </Grid>
</ContentView>