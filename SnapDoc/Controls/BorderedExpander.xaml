<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:local="clr-namespace:SnapDoc"
             x:Class="SnapDoc.Controls.BorderedExpander"
             x:Name="thisControl">

    <ContentView.ControlTemplate>
        <ControlTemplate>
            <Border Stroke="{DynamicResource SecondaryBackground}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="8,0,12,0"
                    Margin="0,0,0,8">
                <toolkit:Expander Margin="6">
                    <toolkit:Expander.Header>
                        <Grid ColumnDefinitions="*, Auto" Padding="0,8,0,0">
                            <Label Grid.Column="0"
                                   Text="{TemplateBinding HeaderText}"
                                   VerticalTextAlignment="Center"
                                   VerticalOptions="Center" />
                            <Image Grid.Column="1"
                                   Source="{FontImageSource FontFamily=MaterialOutlined, Color={AppThemeBinding Light={DynamicResource PrimaryText}, Dark={DynamicResource PrimaryDarkText}}, Glyph={x:Static local:MaterialIcons.Stat_minus_1}}"
                                   HeightRequest="16"
                                   WidthRequest="16"
                                   VerticalOptions="Center">
                                <Image.Triggers>
                                    <DataTrigger TargetType="Image"
                                                 Binding="{Binding Path=IsExpanded, Source={RelativeSource AncestorType={x:Type toolkit:Expander}}}"
                                                 Value="True">
                                        <Setter Property="Rotation" Value="180" />
                                    </DataTrigger>
                                </Image.Triggers>
                            </Image>
                        </Grid>
                    </toolkit:Expander.Header>

                    <ContentPresenter Margin="0,8,0,0" />
                </toolkit:Expander>
            </Border>
        </ControlTemplate>
    </ContentView.ControlTemplate>
</ContentView>