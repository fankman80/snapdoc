<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns:controls="clr-namespace:SnapDoc.Controls"
             xmlns:res="clr-namespace:SnapDoc.Resources.Languages"
             xmlns:local="clr-namespace:SnapDoc"
             x:Class="SnapDoc.Controls.FillEditorView"
             x:DataType="controls:FillEditorView">

    <ContentView.Resources>
        <Style x:Key="SectionLabel" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="#9E9E9E" />
        </Style>

        <Style TargetType="controls:RangeSlider">
            <Setter Property="IsRealtime" Value="True" />
            <Setter Property="IsRange" Value="False" />
            <Setter Property="TextColor" Value="#9E9E9E" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="ValueFontSize" Value="12" />
            <Setter Property="MinimumTrackColor" Value="{DynamicResource PrimaryDarkAccent}" />
            <Setter Property="MaximumTrackColor" Value="Gray" />
        </Style>
    </ContentView.Resources>

    <VerticalStackLayout Spacing="6">
        <!-- Füllfarbe inkl. "keine Füllung" -->
        <Label Text="{x:Static res:AppResources.fuellfarbe}" Style="{StaticResource SectionLabel}" />
        <controls:ColorSwatchBar SelectedColor="{Binding FillColor}"
                                 ShowNoneSwatch="True"
                                 DefaultAlpha="0.5" />

        <!-- Deckkraft -->
        <controls:RangeSlider LabelText="{x:Static res:AppResources.deckkraft}"
                              Minimum="0" Maximum="100" Step="5"
                              MinimumValueDisplayFormat="{}{0} %"
                              LowerValue="{Binding FillOpacity}" />

        <!-- Schraffur -->
        <controls:Switch LabelText="{x:Static res:AppResources.hatchFill}"
                         TextColor="White"
                         IsToggled="{Binding IsHatchEffect}"
                         HorizontalOptions="Start"
                         BorderColorOff="Transparent"
                         KnobColorOn="White"
                         KnobColorOff="White"
                         SwitchColorOn="{DynamicResource PrimaryDark}"
                         SwitchColorOff="Gray" />

        <VerticalStackLayout IsVisible="{Binding IsHatchEffect}" Spacing="4">

            <!-- Winkel + Spiegeln -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                <controls:RangeSlider Grid.Column="0"
                                      LabelText="{x:Static res:AppResources.hatchAngle}"
                                      Minimum="{Binding HatchRotation, Converter={StaticResource MathExpressionConverter}, ConverterParameter='x&lt;0?-90:0'}"
                                      Maximum="{Binding HatchRotation, Converter={StaticResource MathExpressionConverter}, ConverterParameter='x&lt;0?0:90'}"
                                      Step="1"
                                      MinimumValueDisplayFormat="{}{0}°"
                                      LowerValue="{Binding HatchRotation}" />
                <Button Grid.Column="1"
                        Padding="0"
                        VerticalOptions="End"
                        BackgroundColor="Transparent"
                        ToolTipProperties.Text="{x:Static res:AppResources.schraffur_spiegeln}"
                        Clicked="FlipRotationAngleClick">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialOutlined"
                                         Color="{DynamicResource PrimaryDarkAccent}"
                                         Glyph="{x:Static local:MaterialIcons.Flip}" />
                    </Button.ImageSource>
                </Button>
            </Grid>

            <!-- Linienbreite und Abstand nebeneinander -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <controls:RangeSlider Grid.Column="0"
                                      LabelText="{x:Static res:AppResources.HatchLineWidth}"
                                      Minimum="0" Maximum="40" Step="1"
                                      MinimumValueDisplayFormat="{}{0} px"
                                      LowerValue="{Binding HatchStrokeWitdh}" />
                <controls:RangeSlider Grid.Column="1"
                                      LabelText="{x:Static res:AppResources.HatchSpacing}"
                                      Minimum="0" Maximum="40" Step="1"
                                      MinimumValueDisplayFormat="{}{0} px"
                                      LowerValue="{Binding HatchStrokeSpace}" />
            </Grid>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentView>