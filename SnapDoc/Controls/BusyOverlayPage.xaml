<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="Transparent"
             NavigationPage.HasNavigationBar="False"
             x:Class="SnapDoc.Controls.BusyOverlayPage">

    <Grid>
        <!-- Abdunklung der gesamten aktuellen Seite -->
        <BoxView
            BackgroundColor="Black"
            Opacity="0.7" />

        <!-- Zentrale Busy-Box -->
        <Border
            Padding="30,30"
            BackgroundColor="Transparent"
            StrokeThickness="0"
            HorizontalOptions="Fill"
            VerticalOptions="Fill">

            <VerticalStackLayout
                Spacing="16"
                VerticalOptions="Center"
                HorizontalOptions="Center">

                <!-- Weißer Spinner -->
                <ActivityIndicator
                    IsRunning="True"
                    IsVisible="True"
                    Color="White"
                    WidthRequest="55"
                    HeightRequest="55"
                    HorizontalOptions="Center" />

                <!-- Text -->
                <Label
                    x:Name="MessageLabel"
                    Text="Bitte warten..."
                    TextColor="White"
                    FontSize="18"
                    HorizontalTextAlignment="Center"
                    HorizontalOptions="Center" />

            </VerticalStackLayout>

        </Border>

    </Grid>
</ContentPage>