<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SnapDoc"
             x:Class="SnapDoc.Controls.BorderedEntry"
             x:Name="this">

    <Grid Padding="0,4,0,0">
        <Border x:Name="ContainerBorder"
                Stroke="{Binding BorderColor, Source={x:Reference this}}"
                StrokeThickness="{Binding BorderThickness, Source={x:Reference this}}"
                Padding="16,0"
                HeightRequest="50">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="{Binding CornerRadius, Source={x:Reference this}}" />
            </Border.StrokeShape>

            <Border.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding IsFocused, Source={x:Reference InnerEntry}}" Value="True">
                    <Setter Property="Stroke" Value="{Binding FocusedBorderColor, Source={x:Reference this}}" />
                    <Setter Property="StrokeThickness" Value="{Binding FocusedBorderThickness, Source={x:Reference this}}" />
                </DataTrigger>
            </Border.Triggers>

            <local:BorderlessEntry x:Name="InnerEntry"
                                   Text="{Binding Text, Source={x:Reference this}, Mode=TwoWay}"
                                   TextColor="{Binding TextColor, Source={x:Reference this}}"
                                   FontSize="{Binding FontSize, Source={x:Reference this}}"
                                   FontFamily="{Binding FontFamily, Source={x:Reference this}}"
                                   IsPassword="{Binding IsPassword, Source={x:Reference this}}"
                                   Keyboard="{Binding Keyboard, Source={x:Reference this}}"
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center"
                                   Focused="InnerEntry_Focused"
                                   Unfocused="InnerEntry_Unfocused"
                                   TextChanged="InnerEntry_TextChanged" />
        </Border>

        <Label x:Name="FloatingLabel"
               Text="{Binding Placeholder, Source={x:Reference this}}"
               TextColor="{Binding PlaceholderColor, Source={x:Reference this}}"
               BackgroundColor="{Binding LabelBackgroundColor, Source={x:Reference this}}"
               FontSize="{Binding FontSize, Source={x:Reference this}}"
               FontFamily="{Binding FontFamily, Source={x:Reference this}}"
               HorizontalOptions="Start"
               VerticalOptions="Center"
               Margin="10,0,0,0"
               Padding="8,0"
               AnchorX="0"
               InputTransparent="True" />
    </Grid>
</ContentView>