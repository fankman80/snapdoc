<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SnapDoc.Controls"
             xmlns:local="clr-namespace:SnapDoc"
             x:Class="SnapDoc.Views.HomeScreen"
             Shell.TitleColor="{DynamicResource PrimaryDark}"
             Shell.BackgroundColor="#5c5c5c"
             BackgroundColor="#5c5c5c">

    <ContentPage.Content>
        <Grid>
            <controls:SvgView
                Margin="50"
                HeightRequest="{OnPlatform WinUI=300, Default=-1}"
                WidthRequest="{OnPlatform WinUI=300, Default=-1}"
                Source="logo.svg"
                TintColor="{DynamicResource Primary}"
                TargetHexColor="#00b1ca"
                Aspect="AspectFit" />
            <Label Text="{x:Static local:Settings.AppCopyright}"
                   Margin="0,0,0,20"
                   TextColor="LightGray"
                   HorizontalOptions="Center"
                   VerticalOptions="End"/>

            <VerticalStackLayout HorizontalOptions="End" VerticalOptions="Start" Margin="20" Spacing="10">
                <Button Text="Logout"
                        IsVisible="{Binding IsLoggedIn}"
                        WidthRequest="100"                        
                        BackgroundColor="Red"
                        TextColor="{DynamicResource PrimaryDarkText}"
                        HorizontalOptions="End"
                        Clicked="OnLogoutClicked"/>
                <Button Text="Login"
                        IsVisible="{Binding NotLoggedIn}"
                        WidthRequest="100"
                        BackgroundColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"
                        TextColor="{DynamicResource PrimaryDarkText}"
                        HorizontalOptions="End"
                        Clicked="OnSharepointClicked"/>
                <Label IsVisible="{Binding IsLoggedIn}" Text="{Binding CurrentUserName}" TextColor="LightGray" HorizontalOptions="End" />
                <Label IsVisible="{Binding IsLoggedIn}" Text="{Binding CurrentUserEmail}" TextColor="LightGray" HorizontalOptions="End" />
            </VerticalStackLayout>

        </Grid>
    </ContentPage.Content>
</ContentPage>
