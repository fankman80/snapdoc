<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns:res="clr-namespace:SnapDoc.Resources.Languages"
               xmlns:views="clr-namespace:SnapDoc.Views"      
               BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryBackground}, Dark={DynamicResource PrimaryBackgroundDark}}"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               x:TypeArguments="x:String"
               x:DataType="views:PopupRadioPicker"
               x:Class="SnapDoc.Views.PopupRadioPicker">

    <Grid Padding="6,6,6,0"
          WidthRequest="240"
          VerticalOptions="Center">
        <Grid RowDefinitions="Auto, Auto" RowSpacing="0">
            <ScrollView Grid.Row="0"
                        MaximumHeightRequest="400">
                <VerticalStackLayout x:Name="RadioGroupContainer"
                                     Spacing="0"
                                     HorizontalOptions="Start"
                                     RadioButtonGroup.GroupName="PickerGroup">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <RadioButton Content="{Binding .}"
                                         Value="{Binding .}"
                                         BorderColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDarkAccent}}"
                                         CheckedChanged="OnRadioButtonCheckedChanged"/>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView>

            <Button Grid.Row="1"
                    HorizontalOptions="End"
                    Text="{x:Static res:AppResources.abbrechen}"
                    FontAttributes="Bold"
                    BackgroundColor="Transparent" 
                    TextColor="{DynamicResource Primary}"
                    Clicked="OnCancelClicked" />
        </Grid>
    </Grid>
</toolkit:Popup>