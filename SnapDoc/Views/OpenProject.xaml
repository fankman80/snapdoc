<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:SnapDoc.Views"
             xmlns:viewmodels="clr-namespace:SnapDoc.ViewModels"
             xmlns:services="clr-namespace:SnapDoc.Services"
             xmlns:res="clr-namespace:SnapDoc.Resources.Languages"
             xmlns:local="clr-namespace:SnapDoc"
             Shell.TitleColor="{DynamicResource PrimaryDark}"
             Shell.BackgroundColor="{DynamicResource SecondaryBackgroundDark}"
             BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryBackground}, Dark={DynamicResource PrimaryBackgroundDark}}"
             x:Class="SnapDoc.Views.OpenProject"
             x:DataType="views:OpenProject"             
             x:Name="ThisPage"
             Title="{x:Static res:AppResources.projektliste}">

    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="0" VerticalOptions="Center">
            <Label Grid.Column="0"
                   x:DataType="views:OpenProject"
                   Text="{Binding Title, Source={x:Reference Name=ThisPage}}"
                   TextColor="{DynamicResource PrimaryDark}"
                   BackgroundColor="Transparent"
                   FontSize="18"
                   VerticalOptions="Center"
                   HorizontalOptions="Start"/>
            <Button Grid.Column="1"
                    Text="{x:Static local:MaterialIcons.Add}"
                    FontSize="24"
                    Padding="0"
                    TextColor="{DynamicResource PrimaryDark}"
                    Background="Transparent"
                    FontFamily="MaterialOutlined"
                    VerticalOptions="Center"
                    HorizontalOptions="End"
                    ToolTipProperties.Text="{x:Static res:AppResources.neues_projekt_erstellen}"
                    Clicked="OnAddClicked"/>
        </Grid>
    </Shell.TitleView>

    <ContentPage.Resources>
        <Style x:Key="MenuRow" TargetType="Grid">
            <Setter Property="ColumnDefinitions" Value="Auto,*" />
            <Setter Property="ColumnSpacing" Value="14" />
            <Setter Property="HeightRequest" Value="48" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
        <Style x:Key="MenuIcon" TargetType="Label">
            <Setter Property="FontFamily" Value="MaterialOutlined" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDarkAccent}}" />
        </Style>
        <Style x:Key="MenuText" TargetType="Label">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={DynamicResource PrimaryText}, Dark={DynamicResource PrimaryDarkText}}" />
        </Style>
    </ContentPage.Resources>

    <Grid x:Name="RootGrid" RowDefinitions="*,Auto" Margin="16,10,16,6">
        <CollectionView x:Name="FileListView" Grid.Row="0"
                SelectionMode="None"
                ItemsUpdatingScrollMode="KeepScrollOffset"
                Scrolled="OnFileListScrolled">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="1" VerticalItemSpacing="6"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:FileItem">
                    <Border StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDarkAccent}}"
                            StrokeShape="RoundRectangle 4">
                        <Grid ColumnDefinitions="66,*,Auto"
                              RowDefinitions="25,37"
                              ColumnSpacing="0"
                              RowSpacing="4"
                              Opacity="{Binding DisplayOpacity}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnProjectClicked" />
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" Grid.ColumnSpan="3" Grid.RowSpan="2"
                                    BackgroundColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDarkAccent}}"
                                    Opacity="0.1"
                                    IsVisible="{Binding IsActive}" />
                            <Label Grid.Column="1" Grid.Row="0"
                                   Margin="8,4,0,0"
                                   VerticalTextAlignment="Center"
                                   MaxLines="1"
                                   LineBreakMode="TailTruncation"
                                   TextColor="{AppThemeBinding Light={DynamicResource PrimaryText}, Dark={DynamicResource PrimaryDarkText}}"
                                   FontAttributes="{Binding IsActive, Converter={StaticResource BoolToFontAttributesConverter}}"
                                   Text="{Binding FileName}"/>
                            <Label Grid.Column="1" Grid.Row="1"
                                   Margin="8,0,0,0"
                                   FontSize="12"
                                   VerticalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={DynamicResource PrimaryText}, Dark={DynamicResource PrimaryDarkText}}"
                                   FontAttributes="{Binding IsActive, Converter={StaticResource BoolToFontAttributesConverter}}"
                                   Text="{Binding FileDate, StringFormat='{0:dddd dd.MM.yyyy | HH:mm}'}"/>
                            <Image Grid.Column="0" Grid.RowSpan="2"
                                   Source="{Binding ThumbnailPath}"
                                   Aspect="AspectFill"/>
                            <Border Grid.Column="0" Grid.RowSpan="2"
                                    IsVisible="{Binding HasCloudSync}"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Start"
                                    Margin="4"
                                    WidthRequest="26"
                                    HeightRequest="26"
                                    Padding="0"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 13"
                                    BackgroundColor="White">
                                <Label Text="{x:Static local:MaterialIcons.Cloud}"
                                       FontSize="16"
                                       FontFamily="MaterialOutlined"
                                       TextColor="{DynamicResource Primary}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                            <Button Grid.Column="2" Grid.RowSpan="2"
                                    IsEnabled="{Binding IsSyncChecked}"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    Padding="0"
                                    VerticalOptions="Center"
                                    Text="{x:Static local:MaterialIcons.More_vert}"
                                    FontSize="26"
                                    FontFamily="MaterialOutlined"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDarkAccent}}"
                                    ToolTipProperties.Text="{x:Static res:AppResources.weitere_optionen}"
                                    Clicked="OnItemMoreClicked">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup Name="CommonStates">
                                            <VisualState Name="Normal">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="Transparent" />
                                                    <Setter Property="Opacity" Value="1" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState Name="Disabled">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="Transparent" />
                                                    <Setter Property="Opacity" Value="1" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState Name="Focused">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="Transparent" />
                                                    <Setter Property="Opacity" Value="1" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="Transparent" />
                                                    <Setter Property="Opacity" Value="1" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="Transparent" />
                                                    <Setter Property="Opacity" Value="1" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- ═══ "+"-Menü ═══ -->
        <Grid x:Name="AddMenuOverlay"
              Grid.RowSpan="2"
              IsVisible="False"
              BackgroundColor="Transparent">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnAddMenuDismiss" />
            </Grid.GestureRecognizers>

            <Border x:Name="AddMenu"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    Margin="0"
                    Padding="10"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#2B2D31}">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.25" Radius="12" Offset="0,4" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>

                <VerticalStackLayout>
                    <!-- Neues Projekt -->
                    <Grid ColumnDefinitions="Auto,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMenuNewTapped" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0"
                               FontSize="18"
                               VerticalTextAlignment="Center"
                               FontFamily="MaterialOutlined"
                               Text="{x:Static local:MaterialIcons.Add}" />
                        <Label Grid.Column="1"
                               FontSize="12"
                               VerticalTextAlignment="Center"
                               Text="{x:Static res:AppResources.neues_projekt_erstellen}" />
                    </Grid>

                    <!-- Zip importieren -->
                    <Grid ColumnDefinitions="Auto,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMenuZipImportTapped" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0"
                               FontSize="18"
                               VerticalTextAlignment="Center"
                               FontFamily="MaterialOutlined"
                               Text="{x:Static local:MaterialIcons.Folder_zip}" />
                        <Label Grid.Column="1"
                               FontSize="12"
                               VerticalTextAlignment="Center"
                               Text="{x:Static res:AppResources.projektdatei_importieren}" />
                    </Grid>

                    <!-- Aus Cloud laden (nur angemeldet) -->
                    <Grid ColumnDefinitions="Auto,Auto"
                          IsVisible="{Binding Source={x:Static services:SettingsService.Instance}, Path=IsCloudLoggedIn, x:DataType=services:SettingsService}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMenuCloudDownloadTapped" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0"
                               FontSize="18"
                               VerticalTextAlignment="Center"
                               FontFamily="MaterialOutlined"
                               Text="{x:Static local:MaterialIcons.Cloud_download}" />
                        <Label Grid.Column="1"
                               FontSize="12"
                               VerticalTextAlignment="Center"
                               Text="{x:Static res:AppResources.aus_cloud_laden}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- ═══ Projekt-Menü ═══ -->
        <Grid x:Name="ItemSheetOverlay"
              Grid.RowSpan="2"
              IsVisible="False"
              BackgroundColor="Transparent">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnItemSheetDismiss" />
            </Grid.GestureRecognizers>

            <Border x:Name="ItemSheet"
                    x:DataType="local:FileItem"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    Margin="0"
                    Padding="10"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#2B2D31}">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.25" Radius="12" Offset="0,4" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>

                <VerticalStackLayout>
                    <!-- Zip exportieren (nur aktives Projekt) -->
                    <Grid ColumnDefinitions="Auto,Auto"
                          IsVisible="{Binding IsActive}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSheetZipExportTapped" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0"
                               FontSize="18"
                               VerticalTextAlignment="Center"
                               FontFamily="MaterialOutlined"
                               Text="{x:Static local:MaterialIcons.Folder_zip}" />
                        <Label Grid.Column="1"
                               FontSize="12"
                               VerticalTextAlignment="Center"
                               Text="{x:Static res:AppResources.zip_exportieren}" />
                    </Grid>

                    <!-- Verzeichnis öffnen (nur Windows) -->
                    <Grid ColumnDefinitions="Auto,Auto"
                          IsVisible="{OnPlatform Default=False, WinUI=True}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSheetOpenFolderTapped" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0"
                               FontSize="18"
                               VerticalTextAlignment="Center"
                               FontFamily="MaterialOutlined"
                               Text="{x:Static local:MaterialIcons.Folder_open}" />
                        <Label Grid.Column="1"
                               FontSize="12"
                               VerticalTextAlignment="Center"
                               Text="{x:Static res:AppResources.verzeichnis_oeffnen}" />
                    </Grid>

                    <!-- In Cloud hochladen (angemeldet, noch nicht synchronisiert) -->
                    <Grid x:Name="SheetUploadRow"
                          ColumnDefinitions="Auto,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSheetUploadTapped" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0"
                               FontSize="18"
                               VerticalTextAlignment="Center"
                               FontFamily="MaterialOutlined"
                               Text="{x:Static local:MaterialIcons.Cloud_upload}" />
                        <Label Grid.Column="1"
                               FontSize="12"
                               VerticalTextAlignment="Center"
                               Text="{x:Static res:AppResources.in_cloud_hochladen}" />
                    </Grid>

                    <BoxView x:Name="SheetDivider"
                             HeightRequest="1"
                             Margin="0"
                             Color="{AppThemeBinding Light=#1F000000, Dark=#33FFFFFF}" />

                    <!-- Löschen (destruktiv, rot) -->
                    <Grid ColumnDefinitions="Auto,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSheetDeleteTapped" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0"
                               FontSize="18"
                               VerticalTextAlignment="Center"
                               FontFamily="MaterialOutlined"
                               Text="{x:Static local:MaterialIcons.Delete}"
                               TextColor="{AppThemeBinding Light=#B3261E, Dark=#F2B8B5}" />
                        <Label Grid.Column="1"
                               FontSize="12"
                               VerticalTextAlignment="Center"
                               Text="{x:Static res:AppResources.loeschen}"
                               TextColor="{AppThemeBinding Light=#B3261E, Dark=#F2B8B5}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Label Grid.Row="1"
               x:Name="ProjectCounterLabel"
               FontSize="12"/>
    </Grid>
</ContentPage>
