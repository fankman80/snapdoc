<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:SnapDoc.Views"
             xmlns:viewmodels="clr-namespace:SnapDoc.ViewModels"
             xmlns:services="clr-namespace:SnapDoc.Services"
             xmlns:res="clr-namespace:SnapDoc.Resources.Languages"
             xmlns:local="clr-namespace:SnapDoc"
             Shell.TitleColor="{DynamicResource PrimaryDark}"
             Shell.BackgroundColor="{DynamicResource SecondaryBackgroundDark}"
             BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryBackground}, Dark={DynamicResource PrimaryBackgroundDark}}"
             x:Class="SnapDoc.Views.OpenProject"
             x:DataType="views:OpenProject"             
             x:Name="ThisPage"
             Title="{x:Static res:AppResources.projektliste}">

    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto,Auto,Auto"
              ColumnSpacing="0"
              VerticalOptions="Center">
            <Label Grid.Column="0"
                   x:DataType="views:OpenProject"
                   Text="{Binding Title, Source={x:Reference Name=ThisPage}}"
                   TextColor="{DynamicResource PrimaryDark}"
                   Background="Transparent"
                   BackgroundColor="Transparent"
                   FontSize="18"
                   VerticalOptions="Center"
                   HorizontalOptions="Start"/>
            <Button Grid.Column="1"
                    IsVisible="{Binding Source={x:Static services:SettingsService.Instance}, Path=IsCloudLoggedIn, x:DataType=services:SettingsService}"
                    Text="{x:Static local:MaterialIcons.Cloud_download}"
                    FontSize="24"
                    Padding="0"
                    TextColor="{DynamicResource PrimaryDark}"
                    Background="Transparent"
                    FontFamily="MaterialOutlined"
                    VerticalOptions="Center"
                    HorizontalOptions="End"
                    ToolTipProperties.Text="{x:Static res:AppResources.von_sharepoint_oder_onedrive_herunterladen}"
                    Clicked="OnDownloadFromCloudClicked"/>
            <Button Grid.Column="2"    
                    Text="{x:Static local:MaterialIcons.Folder_zip}"
                    FontSize="24"
                    Padding="0"
                    TextColor="{DynamicResource PrimaryDark}"
                    Background="Transparent"
                    FontFamily="MaterialOutlined"
                    VerticalOptions="Center"
                    HorizontalOptions="End"
                    ToolTipProperties.Text="{x:Static res:AppResources.projektdatei_importieren}"
                    Clicked="OnUploadClicked"/>
            <Button Grid.Column="3"         
                    Text="{x:Static local:MaterialIcons.Add_home}"
                    FontSize="24"
                    Padding="0"
                    TextColor="{DynamicResource PrimaryDark}"
                    Background="Transparent"
                    FontFamily="MaterialOutlined"
                    VerticalOptions="Center"
                    HorizontalOptions="End"
                    ToolTipProperties.Text="{x:Static res:AppResources.neues_projekt_erstellen}"
                    Clicked="OnNewClicked"/>
        </Grid>
    </Shell.TitleView>

    <Grid RowDefinitions="*,Auto" Margin="8">
        <CollectionView x:Name="FileListView" Grid.Row="0"
                        SelectionMode="None"
                        ItemsUpdatingScrollMode="KeepScrollOffset">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="1" VerticalItemSpacing="6" HorizontalItemSpacing="6"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:FileItem">
                    <Border StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDarkAccent}}"
                            StrokeShape="RoundRectangle 4">
                        <Grid ColumnDefinitions="66,*,Auto"
                              RowDefinitions="25,37"
                              ColumnSpacing="8"
                              RowSpacing="4">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnProjectClicked" />
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" Grid.ColumnSpan="3" Grid.RowSpan="2"
                                    BackgroundColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDarkAccent}}"
                                    Opacity="0.1"
                                    IsVisible="{Binding IsActive}" />
                            <Label Grid.Column="1" Grid.Row="0"
                                    VerticalTextAlignment="Center"
                                    MaxLines="1"
                                    LineBreakMode="TailTruncation"
                                    TextColor="{AppThemeBinding Light={DynamicResource PrimaryText}, Dark={DynamicResource PrimaryDarkText}}"
                                    FontAttributes="{Binding IsActive, Converter={StaticResource BoolToFontAttributesConverter}}"
                                    Text="{Binding FileName}"/>
                            <Label Grid.Column="1" Grid.Row="1"
                                    FontSize="12"
                                    VerticalTextAlignment="Center"
                                    TextColor="{AppThemeBinding Light={DynamicResource PrimaryText}, Dark={DynamicResource PrimaryDarkText}}"
                                    FontAttributes="{Binding IsActive, Converter={StaticResource BoolToFontAttributesConverter}}"
                                    Text="{Binding FileDate, StringFormat='{0:dddd dd.MM.yyyy | HH:mm}'}"/>
                            <Image Grid.Column="0" Grid.RowSpan="2"
                                    Source="{Binding ThumbnailPath}"
                                    Aspect="AspectFill"/>      
                            <Border Grid.Column="0" Grid.RowSpan="2"
                                    IsVisible="{Binding HasCloudSync}"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Start"
                                    Margin="4"
                                    WidthRequest="26"
                                    HeightRequest="26"
                                    Padding="0"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 13"
                                    BackgroundColor="White">
                                <Label Text="{x:Static local:MaterialIcons.Cloud}"
                                        FontSize="16"
                                        FontFamily="MaterialOutlined"
                                        TextColor="{DynamicResource Primary}"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"/>
                            </Border>
                            <Button Grid.Column="2" Grid.RowSpan="2"
                                    Padding="0"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center"
                                    Text="{x:Static local:MaterialIcons.Edit_square}"
                                    FontSize="30"
                                    FontFamily="MaterialOutlined"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDarkAccent}}"
                                    Clicked="OnEditClicked"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        
        <Label Grid.Row="1"
               x:Name="ProjectCounterLabel"
               FontSize="12"/>
    </Grid>
</ContentPage>
