<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns:views="clr-namespace:SnapDoc.Views"
               xmlns:controls="clr-namespace:SnapDoc.Controls"
               xmlns:res="clr-namespace:SnapDoc.Resources.Languages"
               xmlns:local="clr-namespace:SnapDoc"
               BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryBackground}, Dark={DynamicResource PrimaryBackgroundDark}}"
               HorizontalOptions="Center"
               x:TypeArguments="local:PlanEditReturn"
               x:Class="SnapDoc.Views.PopupPlanEdit">

    <Grid x:DataType="views:PopupPlanEdit"
          WidthRequest="320">
        <VerticalStackLayout>
            <controls:BorderedEntry
                x:Name="name_entry"
                Placeholder="{x:Static res:AppResources.planbezeichnung}"/>
            <controls:BorderedEditor
                x:Name="desc_entry"
                Placeholder="{x:Static res:AppResources.beschreibung}"/>
            <Grid>
                <Border HeightRequest="44"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10">
                    <Image Source="pattern.png" Aspect="Center"/>
                </Border>
                <Border BackgroundColor="{Binding SelectedColor}"
                        HeightRequest="44"                        
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"/>
                <Button BorderWidth="1"
                        HeightRequest="44"
                        BorderColor="Black"
                        BackgroundColor="Transparent"
                        Text="{x:Static res:AppResources.planfarbe}"
                        TextColor="{Binding SelectedColor, Converter={StaticResource ColorToColorForTextConverter}}"
                        Clicked="OnColorPickerClicked"/>
            </Grid>
            <controls:Switch x:Name="allow_export"
                            LabelText="{x:Static res:AppResources.plan_exportieren}"
                            TextColor="{AppThemeBinding Light={DynamicResource PrimaryText}, Dark={DynamicResource PrimaryDarkText}}"
                            HeightRequest="44"                             
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            BorderColorOff ="Transparent"
                            KnobColorOn="White"
                            KnobColorOff="White"
                            SwitchColorOn="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"
                            SwitchColorOff="{AppThemeBinding Light=LightGray, Dark=Gray}"/>

            <Grid ColumnDefinitions="*,50,50">
                <controls:LocalizedLabel Grid.Column="0"
                                         VerticalTextAlignment="Center"
                                         ResourceKey="plan_drehung"
                                         Value="{Binding PlanRotate}"
                                         ValueFormat="{}: {0}°"/>
                <Button Grid.Column="1"
                        Padding="0"
                        BackgroundColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"
                        TextColor="{DynamicResource PrimaryDarkText}"
                        Clicked="PlanRotateRight">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialOutlined"
                                         Color="{DynamicResource PrimaryDarkText}"
                                         Glyph="{x:Static local:MaterialIcons.Rotate_right}" />
                    </Button.ImageSource>
                </Button>
                <Button Grid.Column="2"
                        Padding="0"
                        BackgroundColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"
                        TextColor="{DynamicResource PrimaryDarkText}"
                        Clicked="PlanRotateLeft">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialOutlined"
                                         Color="{DynamicResource PrimaryDarkText}"
                                         Glyph="{x:Static local:MaterialIcons.Rotate_left}" />
                    </Button.ImageSource>
                </Button>
            </Grid>

            <Grid ColumnDefinitions="*,50,50">
                <Label Grid.Column="0"
                       Text="{x:Static res:AppResources.alle_pins_anheften_loesen}" 
                       VerticalTextAlignment="Center"/>
                <Button Grid.Column="1"
                        Padding="0"                     
                        BackgroundColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"
                        TextColor="{DynamicResource PrimaryDarkText}"
                        ToolTipProperties.Text="{x:Static res:AppResources.anheften}"
                        Clicked="OnLockedClicked">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialOutlined"
                                         Color="{DynamicResource PrimaryDarkText}"
                                         Glyph="{x:Static local:MaterialIcons.Lock}" />
                    </Button.ImageSource>
                </Button>
                <Button Grid.Column="2"
                        Padding="0"                        
                        BackgroundColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"
                        TextColor="{DynamicResource PrimaryDarkText}"
                        ToolTipProperties.Text="{x:Static res:AppResources.loesen}"
                        Clicked="OnUnlockedClicked">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialOutlined"
                                         Color="{DynamicResource PrimaryDarkText}"
                                         Glyph="{x:Static local:MaterialIcons.Lock_open_right}" />
                    </Button.ImageSource>
                </Button>
            </Grid>
            
            <Grid ColumnDefinitions="*,50,50" Padding="0,-8,0,0">
                <Label Text="{x:Static res:AppResources.masseinheit}"
                       VerticalTextAlignment="Center"/>
                <controls:BorderedEditor
                    Grid.Column="1" Grid.ColumnSpan="2"
                    x:Name="unit_entry"/>
            </Grid>
            
            <Grid ColumnDefinitions="*,*">
                <Button Grid.Column="0"
                        x:Name="cancelButtonText"
                        Text="{x:Static res:AppResources.abbrechen}"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource Primary}"
                        Clicked="OnCancelClicked" />
                <Button Grid.Column="1"
                        x:Name="okButtonText"
                        Text="{x:Static res:AppResources.ok}"
                        BackgroundColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"
                        TextColor="{DynamicResource PrimaryDarkText}"
                        Clicked="OnOkClicked" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</toolkit:Popup>
