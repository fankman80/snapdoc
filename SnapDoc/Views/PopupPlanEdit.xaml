<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/maui/global"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:brush="clr-namespace:Microsoft.Maui.Controls;assembly=Microsoft.Maui.Controls"
               xmlns:views="clr-namespace:SnapDoc.Views"
               xmlns:services="clr-namespace:SnapDoc.Services"
               xmlns:controls="clr-namespace:SnapDoc.Controls"
               xmlns:res="clr-namespace:SnapDoc.Resources.Languages"
               xmlns:local="clr-namespace:SnapDoc"
               BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryBackground}, Dark={DynamicResource PrimaryBackgroundDark}}"
               HorizontalOptions="Center"
               x:TypeArguments="local:PlanEditReturn"
               x:Class="SnapDoc.Views.PopupPlanEdit">

    <Grid x:DataType="views:PopupPlanEdit"
          Padding="6"
          WidthRequest="320">
        <VerticalStackLayout>
            <controls:BorderedEntry
                x:Name="name_entry"
                Placeholder="{x:Static res:AppResources.planbezeichnung}"
                BackgroundColor="Transparent"
                BorderColor="{DynamicResource SecondaryBackground}"
                PlaceholderColor="{DynamicResource SecondaryBackground}"
                FocusedBorderColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"/>
            <controls:BorderedEditor
                x:Name="desc_entry"
                Placeholder="{x:Static res:AppResources.beschreibung}"
                BackgroundColor="Transparent"
                BorderColor="{DynamicResource SecondaryBackground}"
                PlaceholderColor="{DynamicResource SecondaryBackground}"
                FocusedBorderColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"/>

            <Grid>
                <Border HeightRequest="44"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10">
                    <Image Source="pattern.png" Aspect="Center"/>
                </Border>
                <Border BackgroundColor="{Binding SelectedColor}"
                        HeightRequest="44"                        
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"/>
                <Button BorderWidth="1"
                        HeightRequest="44"
                        BorderColor="Black"
                        BackgroundColor="Transparent"
                        Text="{x:Static res:AppResources.planfarbe}"
                        TextColor="{Binding SelectedColor, Converter={StaticResource ColorToColorForTextConverter}}"
                        Clicked="OnColorPickerClicked"/>
            </Grid>
            <controls:Switch x:Name="allow_export"
                            LabelText="{x:Static res:AppResources.plan_exportieren}"
                            TextColor="{AppThemeBinding Light={DynamicResource PrimaryText}, Dark={DynamicResource PrimaryDarkText}}"
                            HeightRequest="44"                             
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            BorderColorOff ="Transparent"
                            KnobColorOn="White"
                            KnobColorOff="White"
                            SwitchColorOn="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"
                            SwitchColorOff="{AppThemeBinding Light=LightGray, Dark=Gray}"/>

            <Grid ColumnDefinitions="*, 50, 50">
                <controls:LocalizedLabel Grid.Column="0"
                                         VerticalTextAlignment="Center"
                                         ResourceKey="plan_drehung"
                                         Value="{Binding PlanRotate}"
                                         ValueFormat="{}: {0}°"/>
                <Button Grid.Column="1"
                        Padding="0"
                        BackgroundColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"
                        TextColor="{DynamicResource PrimaryDarkText}"
                        ImageSource="{FontImageSource FontFamily=MaterialOutlined, Color={DynamicResource PrimaryDarkText}, Glyph={x:Static local:MaterialIcons.Rotate_left}}"
                        Clicked="PlanRotateLeft"/>
                <Button Grid.Column="2"
                        Padding="0"
                        BackgroundColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"
                        TextColor="{DynamicResource PrimaryDarkText}"
                        ImageSource="{FontImageSource FontFamily=MaterialOutlined, Color={DynamicResource PrimaryDarkText}, Glyph={x:Static local:MaterialIcons.Rotate_right}}"
                        Clicked="PlanRotateRight" />
            </Grid>

            <Label Text="{x:Static res:AppResources.alle_pins_anheften_loesen}" />
            <Grid ColumnDefinitions="*, *">
                <Button Grid.Column="0"
                        Padding="0"
                        Text="{x:Static res:AppResources.anheften}"                        
                        BackgroundColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"
                        TextColor="{DynamicResource PrimaryDarkText}"
                        ImageSource="{FontImageSource FontFamily=MaterialOutlined, Color={DynamicResource PrimaryDarkText}, Glyph={x:Static local:MaterialIcons.Lock}}"
                        Clicked="OnLockedClicked" />
                <Button Grid.Column="1"
                        Padding="0"                        
                        Text="{x:Static res:AppResources.loesen}" 
                        BackgroundColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"
                        TextColor="{DynamicResource PrimaryDarkText}"
                        ImageSource="{FontImageSource FontFamily=MaterialOutlined, Color={DynamicResource PrimaryDarkText}, Glyph={x:Static local:MaterialIcons.Lock_open_right}}"
                        Clicked="OnUnlockedClicked" />
            </Grid>

            <Button x:Name="grayscaleButtonText"
                    x:DataType="services:SettingsService" BindingContext="{x:Static services:SettingsService.Instance}"
                    IsVisible="{Binding IsExperimentalFunctions}"
                    Padding="0"
                    Text="{x:Static res:AppResources.farben_entfernen}"
                    BackgroundColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"
                    TextColor="{DynamicResource PrimaryDarkText}"
                    ImageSource="{FontImageSource FontFamily=MaterialOutlined, Color={DynamicResource PrimaryDarkText}, Glyph={x:Static local:MaterialIcons.Invert_colors}}"
                    Clicked="OnGrayscaleClicked" />
            <Button Padding="0"
                    Text="{x:Static res:AppResources.plan_loeschen}"
                    BackgroundColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"
                    TextColor="{DynamicResource PrimaryDarkText}"
                    ImageSource="{FontImageSource FontFamily=MaterialOutlined, Color={DynamicResource PrimaryDarkText}, Glyph={x:Static local:MaterialIcons.Delete}}"
                    Clicked="OnDeleteClicked" />
            <Grid ColumnDefinitions="*, *">
                <Button Grid.Column="0"
                        x:Name="cancelButtonText"
                        Text="{x:Static res:AppResources.abbrechen}"
                        BackgroundColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"
                        TextColor="{DynamicResource PrimaryDarkText}"
                        Clicked="OnCancelClicked" />
                <Button Grid.Column="1"
                        x:Name="okButtonText"
                        Text="{x:Static res:AppResources.ok}"
                        BackgroundColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"
                        TextColor="{DynamicResource PrimaryDarkText}"
                        Clicked="OnOkClicked" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</toolkit:Popup>