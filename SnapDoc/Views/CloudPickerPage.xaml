<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:SnapDoc.Views"
             xmlns:viewmodels="clr-namespace:SnapDoc.ViewModels"
             xmlns:models="clr-namespace:SnapDoc.Models"
             xmlns:local="clr-namespace:SnapDoc"
             xmlns:res="clr-namespace:SnapDoc.Resources.Languages"
             Shell.TitleColor="{DynamicResource PrimaryDark}"
             Shell.BackgroundColor="{DynamicResource SecondaryBackgroundDark}"
             BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryBackground}, Dark={DynamicResource PrimaryBackgroundDark}}"
             x:Class="SnapDoc.Views.CloudPickerPage"
             x:DataType="views:CloudPickerPage" 
             x:Name="ThisPage"
             Title="{x:Static res:AppResources.cloud_verzeichnis_waehlen}">

    <Shell.TitleView>
        <HorizontalStackLayout Spacing="0">
            <Label Text="{Binding Title, Source={x:Reference Name=ThisPage}}"
                   LineBreakMode="WordWrap"
                   MaxLines="2"
                   TextColor="{DynamicResource PrimaryDark}"
                   Background="Transparent"
                   BackgroundColor="Transparent"
                   FontSize="18"
                   VerticalOptions="Center"
                   HorizontalOptions="Start"/>
        </HorizontalStackLayout>
    </Shell.TitleView>

    <Grid Margin="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Dynamic Header Card -->
        <Border Grid.Row="0"
                Padding="12,10"
                StrokeShape="RoundRectangle 8"
                Stroke="Transparent"
                BackgroundColor="{AppThemeBinding Light=#10000000, Dark=#15FFFFFF}">
            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                <Label FontFamily="MaterialOutlined"
                       Text="{x:Static local:MaterialIcons.Info}"
                       FontSize="22"
                       TextColor="{DynamicResource Primary}"
                       VerticalOptions="Center" />
                <Label x:DataType="views:CloudPickerPage"
                       Text="{Binding HeaderSubtitle, Source={x:Reference Name=ThisPage}}"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={DynamicResource PrimaryText}, Dark={DynamicResource PrimaryDarkText}}"
                       VerticalOptions="Center"
                       LineBreakMode="WordWrap"/>
            </HorizontalStackLayout>
        </Border>

        <!-- Modern List View -->
        <CollectionView Grid.Row="1"
                        x:DataType="views:CloudPickerPage"
                        ItemsSource="{Binding CloudItems, Source={x:Reference Name=ThisPage}}"
                        SelectionMode="Single"
                        SelectionChanged="OnItemSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CloudItem">
                    <Border StrokeShape="RoundRectangle 8"
                            Stroke="Transparent"
                            BackgroundColor="{AppThemeBinding Light=#08000000, Dark=#10FFFFFF}"
                            Padding="12,10"
                            Margin="0,0,0,6">
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                            <!-- Dynamic Icon -->
                            <Label Grid.Column="0"
                                   FontFamily="MaterialOutlined"
                                   FontSize="24"
                                   TextColor="{DynamicResource Primary}"
                                   VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsFolder}" Value="True">
                                        <Setter Property="Text" Value="{x:Static local:MaterialIcons.Folder}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsFolder}" Value="False">
                                        <Setter Property="Text" Value="{x:Static local:MaterialIcons.Description}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding Id}" Value="..">
                                        <Setter Property="Text" Value="{x:Static local:MaterialIcons.Folder_zip}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>

                            <!-- Name -->
                            <Label Grid.Column="1"
                                   Text="{Binding Name, Source={x:Reference Name=ThisPage}}"
                                   TextColor="{AppThemeBinding Light={DynamicResource PrimaryText}, Dark={DynamicResource PrimaryDarkText}}"
                                   VerticalOptions="Center"
                                   LineBreakMode="TailTruncation" />

                            <!-- Chevron indicator for Folders -->
                            <Label Grid.Column="2"
                                   FontFamily="MaterialOutlined"
                                   Text="{x:Static local:MaterialIcons.Edit_square}"
                                   FontSize="20"
                                   TextColor="Gray"
                                   VerticalOptions="Center"
                                   IsVisible="{Binding IsFolder, Source={x:Reference Name=ThisPage}}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Bottom Action Bar (Only visible in SelectFolder Mode) -->
        <Grid Grid.Row="2" 
              x:DataType="views:CloudPickerPage"
              IsVisible="{Binding IsFolderMode, Source={x:Reference Name=ThisPage}}"
              ColumnDefinitions="*, Auto" 
              ColumnSpacing="10">
            <Button Grid.Column="1" 
                    Text="hier hochladen" 
                    BackgroundColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"
                    TextColor="{DynamicResource PrimaryDarkText}"
                    Clicked="OnSelectFolderClicked"/>
        </Grid>
    </Grid>
</ContentPage>
