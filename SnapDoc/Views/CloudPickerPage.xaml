<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:SnapDoc.Views"
             xmlns:viewmodels="clr-namespace:SnapDoc.ViewModels"
             xmlns:models="clr-namespace:SnapDoc.Models"
             xmlns:local="clr-namespace:SnapDoc"
             xmlns:res="clr-namespace:SnapDoc.Resources.Languages"
             Shell.TitleColor="{DynamicResource PrimaryDark}"
             Shell.BackgroundColor="{DynamicResource SecondaryBackgroundDark}"
             BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryBackground}, Dark={DynamicResource PrimaryBackgroundDark}}"
             x:Class="SnapDoc.Views.CloudPickerPage"
             x:DataType="views:CloudPickerPage" 
             x:Name="ThisPage"
             Title="{x:Static res:AppResources.cloud_verzeichnis_waehlen}">

    <Shell.TitleView>
        <HorizontalStackLayout Spacing="0">
            <Label Text="{Binding Title, Source={x:Reference Name=ThisPage}}"
                   TextColor="{DynamicResource PrimaryDark}"
                   Background="Transparent"
                   BackgroundColor="Transparent"
                   FontSize="18"
                   VerticalOptions="Center"
                   HorizontalOptions="Start"/>
        </HorizontalStackLayout>
    </Shell.TitleView>

    <Grid Margin="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Dynamic Header Card -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" ColumnSpacing="10">
            <Border Grid.Column="0"
                    Padding="12,10"
                    StrokeShape="RoundRectangle 8"
                    Stroke="Transparent"
                    BackgroundColor="{AppThemeBinding Light=#08000000, Dark=#10FFFFFF}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label Grid.Column="0"
                           FontFamily="MaterialOutlined"
                           Text="{x:Static local:MaterialIcons.Info}"
                           FontSize="24"
                           TextColor="{DynamicResource Primary}"
                           VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           x:DataType="views:CloudPickerPage"
                           Text="{Binding HeaderSubtitle, Source={x:Reference Name=ThisPage}}"
                           TextColor="{AppThemeBinding Light={DynamicResource PrimaryText}, Dark={DynamicResource PrimaryDarkText}}"
                           VerticalOptions="Center"
                           LineBreakMode="WordWrap"/>
                </Grid>
            </Border>

            <Button Grid.Column="1"
                    IsVisible="{Binding IsJsonMode, Source={x:Reference Name=ThisPage}}"
                    Text="{x:Static local:MaterialIcons.Document_search}"
                    FontSize="34"
                    Padding="0"
                    TextColor="{DynamicResource PrimaryDark}"
                    Background="Transparent"
                    FontFamily="MaterialOutlined"
                    VerticalOptions="Center"
                    HorizontalOptions="End"
                    ToolTipProperties.Text="{x:Static res:AppResources.suche_nach_projekten}"
                    Clicked="OnSearchProjectsClicked"/>
        </Grid>

        <!-- Modern List View -->
        <CollectionView Grid.Row="1"
                        x:DataType="views:CloudPickerPage"
                        ItemsSource="{Binding CloudItems, Source={x:Reference Name=ThisPage}}"
                        SelectionMode="Single"
                        SelectionChanged="OnItemSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CloudItem">
                    <Border StrokeShape="RoundRectangle 8"
                            Stroke="Transparent"
                            BackgroundColor="{AppThemeBinding Light=#08000000, Dark=#10FFFFFF}"
                            Padding="12,8">
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                            <!-- Dynamic Icon -->
                            <Label Grid.Column="0"
                                   Text="{Binding Icon}"
                                   FontFamily="MaterialOutlined"
                                   FontSize="28"
                                   TextColor="{DynamicResource Primary}"
                                   VerticalOptions="Center"/>
                            <!-- Name -->
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="2"
                                                 VerticalOptions="Center">
                                <Label Text="{Binding Name}"
                                       TextColor="{AppThemeBinding Light={DynamicResource PrimaryText}, Dark={DynamicResource PrimaryDarkText}}"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding LastModifiedText}"
                                       IsVisible="{Binding IsFolder, Converter={StaticResource InvertedBoolConverter}}"
                                       TextColor="{AppThemeBinding Light=LightSlateGray, Dark=LightGray}"
                                       FontSize="12" />
                            </VerticalStackLayout>

                            <!-- Chevron indicator for Folders -->
                            <Label Grid.Column="2"
                                   FontFamily="MaterialOutlined"
                                   Text="{x:Static local:MaterialIcons.Chevron_right}"
                                   FontSize="22"
                                   TextColor="LightSlateGray"
                                   VerticalOptions="Center"
                                   IsVisible="{Binding ShowChevron}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Bottom Action Bar (Only visible in SelectFolder Mode) -->
        <Grid Grid.Row="2" 
              x:DataType="views:CloudPickerPage"
              IsVisible="{Binding IsFolderMode, Source={x:Reference Name=ThisPage}}"
              ColumnDefinitions="*, Auto" 
              ColumnSpacing="10">

            <Button Grid.Column="1" 
                    Text="Projekt hier speichern" 
                    BackgroundColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"
                    TextColor="{DynamicResource PrimaryDarkText}"
                    Clicked="OnSelectFolderClicked"/>
        </Grid>
    </Grid>
</ContentPage>
