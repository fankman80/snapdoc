<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns:lang="clr-namespace:SnapDoc.Resources.Languages"
               x:Class="SnapDoc.Views.PopupMapPreview"
               x:TypeArguments="x:Boolean">

    <Grid RowDefinitions="Auto,Auto,Auto"
          RowSpacing="16"
          WidthRequest="320">

        <Label Grid.Row="0"
               Text="{x:Static lang:AppResources.kartenausschnitt_vorschau}"/>

        <Border Grid.Row="1"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 8"
                HeightRequest="300"
                WidthRequest="300"
                HorizontalOptions="Center">
            <Image x:Name="PreviewImage"
                   Aspect="AspectFit" />
        </Border>

        <HorizontalStackLayout Grid.Row="2"
                               Spacing="8"
                               HorizontalOptions="End">
            <Button Text="{x:Static lang:AppResources.abbrechen}"
                    Clicked="OnRejectClicked"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}" />
            <Button Text="{x:Static lang:AppResources.uebernehmen}"
                    Clicked="OnAcceptClicked" />
        </HorizontalStackLayout>
    </Grid>
</toolkit:Popup>