<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns:res="clr-namespace:SnapDoc.Resources.Languages"
               x:Class="SnapDoc.Views.PopupMapPreview"
               x:TypeArguments="x:Boolean">

    <Grid WidthRequest="320">
        <VerticalStackLayout Spacing="8">
            <Label Text="{x:Static res:AppResources.kartenausschnitt_vorschau}"/>
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 8"
                    HeightRequest="300"
                    WidthRequest="300"
                    HorizontalOptions="Center">
                <Image x:Name="PreviewImage"
                       Aspect="AspectFit" />
            </Border>
            <Grid ColumnDefinitions="*,*" Margin="0,8,0,0">
                <Button Grid.Column="0"
                        Text="{x:Static res:AppResources.abbrechen}"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource Primary}"
                        Clicked="OnRejectClicked"/>
                <Button Grid.Column="1"
                        Text="{x:Static res:AppResources.uebernehmen}"
                        BackgroundColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"
                        TextColor="{DynamicResource PrimaryDarkText}"
                        Clicked="OnAcceptClicked" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</toolkit:Popup>