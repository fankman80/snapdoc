<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:views="clr-namespace:SnapDoc.Views"
             xmlns:services="clr-namespace:SnapDoc.Services"
             xmlns:controls="clr-namespace:SnapDoc.Controls"
             xmlns:res="clr-namespace:SnapDoc.Resources.Languages"
             xmlns:local="clr-namespace:SnapDoc"
             Shell.TitleColor="{DynamicResource PrimaryDark}"
             Shell.BackgroundColor="{DynamicResource SecondaryBackgroundDark}"
             BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryBackground}, Dark={DynamicResource PrimaryBackgroundDark}}"  
             x:DataType="views:SetPin"
             x:Class="SnapDoc.Views.SetPin"
             x:Name="ThisPage"
             Title="{x:Static res:AppResources.pin_bearbeiten}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>

    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto,Auto,Auto"
              ColumnSpacing="0"
              VerticalOptions="Center">
            <Label Grid.Column="0"
                   x:DataType="views:SetPin"
                   Text="{Binding Title, Source={x:Reference Name=ThisPage}}"
                   TextColor="{DynamicResource PrimaryDark}"
                   BackgroundColor="Transparent"
                   FontSize="18"
                   VerticalOptions="Center"
                   HorizontalOptions="Start"/>
            <Button Grid.Column="1"
                    Text="{x:Static local:MaterialIcons.More_vert}"
                    FontSize="24"
                    Padding="0"
                    TextColor="{DynamicResource PrimaryDark}"
                    Background="Transparent"
                    FontFamily="MaterialOutlined"
                    VerticalOptions="Center"
                    HorizontalOptions="End"
                    ToolTipProperties.Text="{x:Static res:AppResources.weitere_optionen}"
                    Clicked="OnMoreClicked"/>
        </Grid>
    </Shell.TitleView>

    <ContentPage.Resources>
        <!-- Karten -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="StrokeShape" Value="8" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="Stroke" Value="{AppThemeBinding Light={DynamicResource Gray300}, Dark=#1FFFFFFF}" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={DynamicResource Gray050}, Dark=#14FFFFFF}" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto" Margin="16">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="10">
                <!-- ═══ Kopfzeile: Icon | Name | Auf Plan zeigen ═══ -->
                <Border Style="{StaticResource CardBorder}" Padding="8">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <!-- Pin-Icon mit Stift-Badge -->
                        <Grid Grid.Column="0" WidthRequest="80" HeightRequest="80">
                            <ImageButton Source="{Binding Pin.DisplayIconPath}"
                                         CornerRadius="0"
                                         BackgroundColor="Transparent"
                                         Aspect="AspectFit"
                                         Padding="4"
                                         ToolTipProperties.Text="{x:Static res:AppResources.icon_aendern}"
                                         Clicked="OnPinSelectClick" />
                            <Border IsVisible="{Binding Pin.IsCustomPin, Converter={StaticResource InvertedBoolConverter}}"
                                    WidthRequest="32"
                                    HeightRequest="32"
                                    StrokeShape="RoundRectangle 16"
                                    StrokeThickness="0"
                                    BackgroundColor="#66000000"
                                    HorizontalOptions="End"
                                    VerticalOptions="End"
                                    Padding="0"
                                    Margin="0,0,-2,-2"
                                    InputTransparent="True">
                                <Label Text="{x:Static local:MaterialIcons.Edit}"
                                       FontFamily="MaterialOutlined"
                                       FontSize="20"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                        </Grid>

                        <!-- Name (editierbar) -->
                        <controls:BorderedEditor Grid.Column="1"
                                                 VerticalOptions="Start"
                                                 HeightRequest="80"
                                                 Text="{Binding Pin.PinName}"
                                                 Placeholder="{x:Static res:AppResources.bezeichnung}"/>

                        <!-- Auf Plan zeigen -->
                        <VerticalStackLayout Grid.Column="2"
                                             Spacing="0"
                                             VerticalOptions="Center">
                            <Button Padding="0"
                                    HeightRequest="30"
                                    WidthRequest="30"
                                    Text="{x:Static local:MaterialIcons.Recenter}"
                                    FontFamily="MaterialOutlined"
                                    FontSize="30"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    CornerRadius="10"
                                    BackgroundColor="Transparent"
                                    TextColor="{DynamicResource Primary}"/>
                            <Label Text="{x:Static res:AppResources.auf_plan_zeigen}"
                                    FontSize="11"
                                    HorizontalTextAlignment="Center"
                                    MaximumWidthRequest="70"
                                    LineBreakMode="WordWrap"
                                    TextColor="{AppThemeBinding Light=SlateGray, Dark=LightGray}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- ═══ Fotos: "+" Galerie scrollt rechts daneben ═══ -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4" HeightRequest="110">
                    <!-- Foto hinzufügen (immer sichtbar) -->
                    <Border Grid.Column="0"
                            WidthRequest="56"
                            HeightRequest="110"
                            StrokeShape="RoundRectangle 10"
                            StrokeDashArray="6,4"
                            StrokeThickness="1.5"
                            Stroke="{AppThemeBinding Light=#40000000, Dark=#55FFFFFF}"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#14FFFFFF}"
                            ToolTipProperties.Text="{x:Static res:AppResources.foto_hinzufuegen}"
                            SemanticProperties.Description="{x:Static res:AppResources.foto_hinzufuegen}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TakeFoto" />
                        </Border.GestureRecognizers>
                        <Label Text="{x:Static local:MaterialIcons.Add_a_photo}"
                               FontFamily="MaterialOutlined"
                               FontSize="30"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDarkAccent}}" />
                    </Border>

                    <!-- Galerie: horizontal -->
                    <CollectionView Grid.Column="1"
                                    x:Name="ImageGallery"
                                    HeightRequest="110"
                                    ItemsSource="{Binding Fotos}"
                                    ItemsUpdatingScrollMode="KeepItemsInView"
                                    CanReorderItems="True"
                                    ReorderCompleted="OnReorderCompleted"
                                    SelectionMode="None"
                                    HorizontalScrollBarVisibility="Never"
                                    VerticalScrollBarVisibility="Never">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout
                                Orientation="Horizontal"
                                ItemSpacing="4"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="local:FotoItem">
                                <!-- Abstand per Margin, da die Kurzform kein ItemSpacing hat -->
                                <Border WidthRequest="110"
                                        HeightRequest="110"
                                        StrokeShape="RoundRectangle 10"
                                        StrokeThickness="0"
                                        Opacity="{Binding DisplayOpacity}">
                                    <Grid>
                                        <Image Source="{Binding DisplayImage}"
                                                Aspect="AspectFill">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnImageTapped" />
                                            </Image.GestureRecognizers>
                                        </Image>
                                        <Button Text="{Binding AllowExport, Converter={StaticResource ExportToGlyphConverter}}"
                                                WidthRequest="32"
                                                HeightRequest="32"
                                                MinimumWidthRequest="32"
                                                MinimumHeightRequest="32"
                                                CornerRadius="16"
                                                Padding="0"
                                                Margin="4"
                                                FontFamily="MaterialOutlined"
                                                FontSize="20"
                                                VerticalOptions="End"
                                                HorizontalOptions="End"
                                                BackgroundColor="#66000000"
                                                TextColor="White"
                                                Clicked="OnAllowExportClicked" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>

                <!-- ═══ Standort ═══ -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="0">
                    <controls:BorderedEntry Grid.Column="0"
                                            Text="{Binding Pin.PinLocation}"
                                            Placeholder="{x:Static res:AppResources.standort}"
                                            ClearButtonVisibility="WhileEditing"/>
                    <Button Grid.Column="1"
                            IsVisible="{Binding Pin.HasGeolocation}"
                            Padding="0"
                            Margin="0,4,0,0"
                            VerticalOptions="Center"
                            BackgroundColor="Transparent"
                            ImageSource="{FontImageSource FontFamily=MaterialOutlined, Color={AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDarkAccent}}, Glyph={x:Static local:MaterialIcons.Globe_location_pin}}"
                            ToolTipProperties.Text="{x:Static res:AppResources.pin_auf_karte_anzeigen}"
                            Clicked="ZoomToWebPinClicked" />
                </Grid>

                <!-- ═══ Beschreibung ═══ -->
                <controls:BorderedEditor Text="{Binding Pin.PinDesc}"
                                         HeightRequest="80"
                                         Placeholder="{x:Static res:AppResources.beschreibung}"/>

                <!-- ═══ Einstellungen ═══ -->
                <!-- Priorität -->
                <Border Style="{StaticResource CardBorder}" Padding="2">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="0">
                        <Button Grid.Column="0"
                                Padding="0"
                                Text="{x:Static local:MaterialIcons.Traffic}"
                                FontSize="28"
                                FontFamily="MaterialOutlined"
                                TextColor="{Binding Pin.PriorityColor}"
                                BackgroundColor="Transparent"
                                VerticalOptions="Center"
                                ToolTipProperties.Text="{x:Static res:AppResources.farbe_waehlen}"
                                Clicked="OnPriorityColorClicked" />
                        <Label Grid.Column="1"
                               Text="{x:Static res:AppResources.prioritaet}"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={DynamicResource PrimaryText}, Dark={DynamicResource PrimaryDarkText}}" />
                        <Border Grid.Column="2"
                                Stroke="Transparent"
                                StrokeThickness="0"
                                Padding="6,0"
                                VerticalOptions="Center">
                            <controls:CustomRadioPicker x:Name="PriorityPicker"
                                                        BackgroundColor="Transparent"
                                                        BorderThickness="0"
                                                        ItemsSource="{Binding Pin.PinPriorites}"
                                                        SelectedIndex="{Binding Pin.PinPriority, Mode=TwoWay}" />
                        </Border>
                        <Button Grid.Column="3"
                                Padding="0"
                                Text="{x:Static local:MaterialIcons.Edit_note}"
                                FontSize="35"
                                FontFamily="MaterialOutlined"
                                TextColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource Primary}}"
                                BackgroundColor="Transparent"
                                VerticalOptions="Center"
                                ToolTipProperties.Text="{x:Static res:AppResources.text_bearbeiten}"
                                Clicked="OnPriorityEditClicked" />
                    </Grid>
                </Border>

                <!-- Pin exportieren -->
                <Border Style="{StaticResource CardBorder}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Label Grid.Column="0"
                               FontSize="26"
                               FontFamily="MaterialOutlined"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDarkAccent}}"
                               BackgroundColor="Transparent"
                               Text="{x:Static local:MaterialIcons.File_export}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="{x:Static res:AppResources.pin_exportieren}"
                                   TextColor="{AppThemeBinding Light={DynamicResource PrimaryText}, Dark={DynamicResource PrimaryDarkText}}" />
                            <Label Text="{x:Static res:AppResources.pin_exportieren_hinweis}"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=SlateGray, Dark=LightGray}"/>
                        </VerticalStackLayout>
                        <controls:Switch Grid.Column="2"
                                         IsToggled="{Binding Pin.IsAllowExport}"
                                         VerticalOptions="Center"
                                         BorderColorOff="Transparent"
                                         KnobColorOn="White"
                                         KnobColorOff="White"
                                         SwitchColorOn="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"
                                         SwitchColorOff="{AppThemeBinding Light=LightGray, Dark=Gray}" />
                    </Grid>
                </Border>

                <!-- Position sperren -->
                <Border Style="{StaticResource CardBorder}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Label Grid.Column="0"
                               FontSize="26"
                               FontFamily="MaterialOutlined"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDarkAccent}}"
                               BackgroundColor="Transparent"
                               Text="{x:Static local:MaterialIcons.Lock}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="{x:Static res:AppResources.position_sperren}"
                                   TextColor="{AppThemeBinding Light={DynamicResource PrimaryText}, Dark={DynamicResource PrimaryDarkText}}" />
                            <Label Text="{x:Static res:AppResources.position_sperren_hinweis}"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=SlateGray, Dark=LightGray}"/>
                        </VerticalStackLayout>
                        <controls:Switch Grid.Column="2"
                                         IsToggled="{Binding Pin.IsLockPosition}"
                                         VerticalOptions="Center"
                                         BorderColorOff="Transparent"
                                         KnobColorOn="White"
                                         KnobColorOff="White"
                                         SwitchColorOn="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"
                                         SwitchColorOff="{AppThemeBinding Light=LightGray, Dark=Gray}"/>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ═══ ⋮-Menü ═══ -->
        <Grid x:Name="MoreMenuOverlay"
              Grid.RowSpan="2"
              IsVisible="False"
              BackgroundColor="Transparent">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnMoreMenuDismiss" />
            </Grid.GestureRecognizers>

            <Border x:Name="MoreMenu"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    Margin="0"
                    Padding="10"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#2B2D31}">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.25" Radius="12" Offset="0,4" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>

                <VerticalStackLayout>
                    <!-- Kopieren / verschieben -->
                    <Grid ColumnDefinitions="Auto,Auto"
                          IsVisible="{Binding Pin.IsWebMapPin, Converter={StaticResource InvertedBoolConverter}}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMenuMoveTapped" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0"
                               FontSize="18"
                               VerticalTextAlignment="Center"                               
                               FontFamily="MaterialOutlined"
                               Text="{x:Static local:MaterialIcons.Move_down}" />
                        <Label Grid.Column="1"
                               FontSize="12"
                               VerticalTextAlignment="Center"
                               Text="{x:Static res:AppResources.kopieren_verschieben}" />
                    </Grid>

                    <BoxView HeightRequest="1"
                             Margin="0"
                             Color="{AppThemeBinding Light=#1F000000, Dark=#33FFFFFF}"
                             IsVisible="{Binding Pin.IsWebMapPin, Converter={StaticResource InvertedBoolConverter}}" />

                    <!-- Löschen (destruktiv, rot) -->
                    <Grid ColumnDefinitions="Auto,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMenuDeleteTapped" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0"
                               FontSize="18"
                               VerticalTextAlignment="Center"                               
                               FontFamily="MaterialOutlined"
                               Text="{x:Static local:MaterialIcons.Delete}"
                               TextColor="{AppThemeBinding Light=#B3261E, Dark=#F2B8B5}" />
                        <Label Grid.Column="1"
                               FontSize="12"
                               VerticalTextAlignment="Center"
                               Text="{x:Static res:AppResources.pin_loeschen}"
                               TextColor="{AppThemeBinding Light=#B3261E, Dark=#F2B8B5}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- ═══ Fixierte Hauptaktion ═══ -->
        <Button Grid.Row="1"
                HorizontalOptions="{OnIdiom Phone=Fill, Default=End}"
                Text="{x:Static res:AppResources.speichern}"
                BackgroundColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"
                TextColor="{DynamicResource PrimaryDarkText}"
                ImageSource="{FontImageSource FontFamily=MaterialOutlined, Size=22, Color={DynamicResource PrimaryDarkText}, Glyph={x:Static local:MaterialIcons.Save}}"
                ContentLayout="Left,10"
                Clicked="OnOkayClicked" />
    </Grid>
</ContentPage>