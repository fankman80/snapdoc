<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:pc="clr-namespace:SnapDoc.ViewModels"
             xmlns:views="clr-namespace:SnapDoc.Views"                
             xmlns:services="clr-namespace:SnapDoc.Services"
             xmlns:controls="clr-namespace:SnapDoc.Controls"
             xmlns:res="clr-namespace:SnapDoc.Resources.Languages"
             xmlns:local="clr-namespace:SnapDoc"
             BackgroundColor="DimGrey"             
             Shell.TitleColor="{DynamicResource PrimaryDark}"
             Shell.BackgroundColor="{DynamicResource SecondaryBackgroundDark}"
             x:Class="SnapDoc.Views.NewPage"
             x:DataType="views:NewPage"
             x:Name="ThisPage"
             Title="{Binding Title}">

    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto,Auto"
              ColumnSpacing="0"
              VerticalOptions="Center">
            <local:BorderlessEntry Grid.Column="0"
                   Text="{Binding Title, Source={x:Reference ThisPage}}"
                   TextColor="{DynamicResource PrimaryDark}"
                   FontFamily="{x:StaticResource AppFontFamily}"
                   Placeholder="{x:Static res:AppResources.titel_eingeben}"
                   PlaceholderColor="{DynamicResource PrimaryDark}"
                   IsSpellCheckEnabled="False"
                   Background="Transparent"
                   BackgroundColor="Transparent"
                   FontSize="18"
                   VerticalOptions="Center"
                   Completed="OnTitleChanged"
                   Unfocused="OnTitleChanged"/>
            <Button Grid.Column="1"                    
                    Text="{x:Static local:MaterialIcons.Fit_screen}"
                    FontSize="24"
                    Padding="0"
                    TextColor="{DynamicResource PrimaryDark}"
                    Background="Transparent"
                    FontFamily="MaterialOutlined"
                    VerticalOptions="Center"
                    HorizontalOptions="End"
                    ToolTipProperties.Text="{x:Static res:AppResources.plan_auf_fenstergroesse_zoomen}"                    
                    Clicked="ImageFit"/>
            <Button Grid.Column="2"                    
                    Text="{x:Static local:MaterialIcons.More_vert}"
                    FontSize="24"
                    Padding="0"
                    TextColor="{DynamicResource PrimaryDark}"
                    Background="Transparent"
                    FontFamily="MaterialOutlined"
                    VerticalOptions="Center"
                    HorizontalOptions="End"
                    ToolTipProperties.Text="{x:Static res:AppResources.weitere_optionen}"                    
                    Clicked="OnMoreClicked"/>
        </Grid>
    </Shell.TitleView>

    <Grid>
        <AbsoluteLayout x:Name="PlanView" IsClippedToBounds="True">
            <controls:TileImageView x:Name="PlanImage"
                                    ShowFpsCounter="{Binding ShowFpsCounter, Source={x:Static services:SettingsService.Instance}, x:DataType=services:SettingsService}"
                                    IsRotationLocked="{Binding IsPlanRotateLocked, Source={x:Static services:SettingsService.Instance}, x:DataType=services:SettingsService}"
                                    IsShowLockBadges="{Binding IsShowLockBadges, Source={x:Static services:SettingsService.Instance}, x:DataType=services:SettingsService}"
                                    SourceImagePath="{Binding PlanImageSource, Source={x:Reference Name=ThisPage}}"
                                    IsGrayscaleEnabled="{Binding IsGrayscaleMode, Source={x:Reference Name=ThisPage}}"
                                    PlaceholderColor="DimGrey"                                    
                                    AbsoluteLayout.LayoutBounds="0, 0, 1, 1"
                                    AbsoluteLayout.LayoutFlags="All"/>

            <Grid x:Name="PinEditBorder"
                  IsVisible="False"
                  AbsoluteLayout.LayoutBounds="0, 0, 1, 1"
                  AbsoluteLayout.LayoutFlags="All">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFullScreenButtonClicked" />
                </Grid.GestureRecognizers>

                <Border BackgroundColor="{DynamicResource Primary}"
                        StrokeThickness="0"
                        HeightRequest="60"
                        VerticalOptions="End"
                        Margin="16,0,16,100"
                        ZIndex="10000">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="30"/>
                    </Border.StrokeShape>
                    <controls:RangeSlider
                            x:Name="PinSizeSlider"
                            ShowLabels="False"
                            IsRealtime="True"
                            IsRange="False"
                            Minimum="1"
                            Maximum="200"
                            Step="1"
                            Margin="61,0,61,0"
                            ThumbColor="{DynamicResource PrimaryDarkText}"
                            MinimumTrackColor="{DynamicResource PrimaryDarkText}"
                            MaximumTrackColor="{DynamicResource PrimaryDarkText}"
                            ValueChanged="OnResizeSliderValueChanged"
                            DragCompleted="OnResizeSliderDragCompleted"/>
                </Border>

                <Button x:Name="LoadCustomPinBtn"                        
                        Text="{x:Static local:MaterialIcons.Draw}"  
                        IsVisible="False"
                        Style="{StaticResource ToolButtonStyle}"
                        Margin="16,0,0,180"
                        ZIndex="10001"
                        HorizontalOptions="Start"
                        VerticalOptions="End"
                        Clicked="LoadCustomPinClicked"/>
                <Button x:Name="SizeModeBtn"
                        FontSize="{OnPlatform 38, iOS=34}"
                        FontFamily="MaterialOutlined"
                        TextColor="{DynamicResource Primary}"
                        BackgroundColor="{DynamicResource PrimaryDarkText}"
                        HeightRequest="50"
                        WidthRequest="50"
                        CornerRadius="25"
                        Padding="0"
                        Margin="21,0,0,105"
                        ZIndex="10001"
                        HorizontalOptions="Start"
                        VerticalOptions="End"
                        Clicked="OnSizeModeClicked"/>
                <Label x:Name="PercentLabel"
                       Text="100%"
                       FontSize="16"
                       VerticalTextAlignment="Center"
                       HorizontalOptions="End"
                       VerticalOptions="End"
                       TextColor="{DynamicResource PrimaryDarkText}"
                       Margin="0,0,26,118"
                       ZIndex="10001"/>
                <Label x:Name="SizeModeLabel"
                       FontSize="11"
                       VerticalTextAlignment="Center"
                       HorizontalOptions="Start"
                       VerticalOptions="End"
                       TextColor="{DynamicResource PrimaryDarkText}"
                       Margin="88,0,0,104"
                       ZIndex="10001"/>
                <Border BackgroundColor="{DynamicResource Primary}"
                        StrokeThickness="0"
                        HeightRequest="60"
                        VerticalOptions="End"
                        Margin="16,0,16,16"
                        ZIndex="10000">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="30"/>
                    </Border.StrokeShape>
                    <controls:RangeSlider
                            x:Name="PinRotateSlider"
                            ShowLabels="False"
                            IsRealtime="True"
                            IsRange="False"
                            Minimum="-180"
                            Maximum="180"
                            Step="1"
                            Margin="61,0,61,0"
                            ThumbColor="{DynamicResource PrimaryDarkText}"
                            MinimumTrackColor="{DynamicResource PrimaryDarkText}"
                            MaximumTrackColor="{DynamicResource PrimaryDarkText}"
                            ValueChanged="OnRotateSliderValueChanged"
                            DragCompleted="OnRotateSliderDragCompleted"/>
                </Border>
                <Button x:Name="RotateModeBtn"
                        FontSize="{OnPlatform 38, iOS=34}"
                        FontFamily="MaterialOutlined"
                        TextColor="{DynamicResource Primary}"
                        BackgroundColor="{DynamicResource PrimaryDarkText}"
                        HeightRequest="50"
                        WidthRequest="50"
                        CornerRadius="25"
                        Padding="0"
                        Margin="21,0,0,21"
                        ZIndex="10001"
                        HorizontalOptions="Start"
                        VerticalOptions="End"
                        Clicked="OnRotateModeClicked"/>
                <Border x:Name="DegreesLabelBorder"
                        HeightRequest="50"
                        WidthRequest="50"
                        BackgroundColor="{DynamicResource PrimaryDarkText}"
                        Margin="0,0,21,21"
                        ZIndex="10001"
                        StrokeThickness="0"
                        HorizontalOptions="End"
                        VerticalOptions="End">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="25"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRotateSnapCklicked" />
                    </Border.GestureRecognizers>
                    <Label x:Name="DegreesLabel"
                           Text="0°"
                           FontSize="16"
                           TextColor="{DynamicResource Primary}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"
                           VerticalTextAlignment="Center"
                           HorizontalTextAlignment="Center"/>
                </Border>
                <Label x:Name="RotateModeLabel"
                       FontSize="11"
                       VerticalTextAlignment="Center"
                       HorizontalOptions="Start"
                       VerticalOptions="End"
                       TextColor="{DynamicResource PrimaryDarkText}"
                       Margin="88,0,0,20"
                       ZIndex="10001"/>
            </Grid>

            <Border IsVisible="{Binding IsToolButtonsVisible, Source={x:Reference ThisPage}}"
                    ZIndex="1000000"
                    Margin="16"
                    Padding="0"
                    BackgroundColor="{DynamicResource Primary}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 8"
                    AbsoluteLayout.LayoutBounds="1, 0, AutoSize, AutoSize"
                    AbsoluteLayout.LayoutFlags="PositionProportional">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.3" Offset="3,3" Radius="3"/>
                </Border.Shadow>
                <HorizontalStackLayout Spacing="0"
                                       IsVisible="{Binding IsMeasureVisible, Source={x:Reference ThisPage}}">
                    <Button Style="{StaticResource ToolButtonStyle}"
                            Text="{x:Static local:MaterialIcons.Design_services}"
                            BackgroundColor="Transparent"
                            Shadow="{x:Null}"
                            IsVisible="{Binding IsRulerActive, Source={x:Reference ThisPage}, Converter={StaticResource InvertedBoolConverter}}"
                            ToolTipProperties.Text="{x:Static res:AppResources.massstab_kalibrieren}"
                            Clicked="OnMeasureAdjust"/>
                    <Button Style="{StaticResource ToolButtonStyle}"
                            Text="{x:Static local:MaterialIcons.Close}"
                            BackgroundColor="Transparent"
                            Shadow="{x:Null}"
                            IsVisible="{Binding IsRulerActive, Source={x:Reference ThisPage}}"
                            ToolTipProperties.Text="{x:Static res:AppResources.messung_abbrechen}"
                            Clicked="OnMeasureCancel"/>
                    <Button Style="{StaticResource ToolButtonStyle}"
                            Text="{x:Static local:MaterialIcons.Check}"
                            BackgroundColor="Transparent"
                            Shadow="{x:Null}"
                            IsVisible="{Binding IsRulerActive, Source={x:Reference ThisPage}}"
                            ToolTipProperties.Text="{x:Static res:AppResources.massstab_uebernehmen}"
                            Clicked="OnMeasureFactorConfirmed"/>
                </HorizontalStackLayout>
            </Border>

            <Border IsVisible="{Binding IsRulerActive, Source={x:Reference ThisPage}}"
                    InputTransparent="True"
                    ZIndex="1000000"
                    Margin="88,0,16,16"
                    Padding="14,10"
                    BackgroundColor="#CC000000"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 8"
                    AbsoluteLayout.LayoutBounds="0, 1, 1, AutoSize"
                    AbsoluteLayout.LayoutFlags="PositionProportional,WidthProportional">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label Text="{x:Static local:MaterialIcons.Straighten}"
                           FontFamily="MaterialOutlined"
                           FontSize="24"
                           TextColor="Red"
                           VerticalOptions="Center"/>
                    <Label Grid.Column="1"
                           Text="{x:Static res:AppResources.hinweis_massstab_kalibrieren}"
                           FontSize="12"
                           TextColor="White"
                           LineBreakMode="WordWrap"
                           VerticalOptions="Center"/>
                </Grid>
            </Border>

            <Button x:DataType="services:SettingsService" BindingContext="{x:Static services:SettingsService.Instance}"
                    IsVisible="{Binding IsButtonActuallyVisible}"
                    Margin="0,0,16,16"
                    ZIndex="10000"
                    Rotation="38"
                    Text="{x:Static local:MaterialIcons.Keep}"  
                    Style="{StaticResource ToolButtonStyle}"
                    AbsoluteLayout.LayoutBounds="1, 1, AutoSize, AutoSize"
                    AbsoluteLayout.LayoutFlags="PositionProportional"
                    ToolTipProperties.Text="{x:Static res:AppResources.pin_setzen}"
                    Clicked="SetPinClicked"/>

            <Button x:Name="DrawBtn"
                    Text="{x:Static local:MaterialIcons.Draw}"   
                    Margin="16,0,0,16"
                    ZIndex="10000"
                    Style="{StaticResource ToolButtonStyle}"
                    AbsoluteLayout.LayoutBounds="0, 1, AutoSize, AutoSize"
                    AbsoluteLayout.LayoutFlags="PositionProportional"
                    ToolTipProperties.Text="{x:Static res:AppResources.formen_zeichnen}"
                    Clicked="DrawingClicked"/>

            <VerticalStackLayout x:DataType="views:NewPage"
                                 IsVisible="{Binding IsToolButtonsVisible, Source={x:Reference Name=ThisPage}}"
                                 Spacing="16"
                                 Margin="16"
                                 HorizontalOptions="Start"
                                 VerticalOptions="End"
                                 ZIndex="10000"
                                 AbsoluteLayout.LayoutBounds="0, 1, AutoSize, AutoSize"
                                 AbsoluteLayout.LayoutFlags="PositionProportional">
                
                <Button x:Name="AddEraserBtn"
                        Text="{x:Static local:MaterialIcons.Ink_eraser}"  
                        Style="{StaticResource ToolButtonStyle}"
                        ToolTipProperties.Text="{x:Static res:AppResources.zeichnung_loeschen}"
                        Clicked="EraseClicked"/>
                <AbsoluteLayout x:Name="AddPaletteBtn">
                    <Button Text="{x:Static local:MaterialIcons.Palette}"  
                            Style="{StaticResource ToolButtonStyle}"
                            ToolTipProperties.Text="{x:Static res:AppResources.farbe_und_stiftbreite_waehlen}"
                            Clicked="PenSettingsClicked"/>
                    <Border WidthRequest="18"
                            HeightRequest="18"
                            BackgroundColor="{Binding Source={x:Reference Name=ThisPage}, Path=SelectedBorderColor, Converter={StaticResource ColorWithoutAlphaConverter}}"                              
                            StrokeThickness="0"
                            AbsoluteLayout.LayoutBounds="0, 0, AutoSize, AutoSize"
                            AbsoluteLayout.LayoutFlags="PositionProportional">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="11"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" 
                                    Opacity="0.3" 
                                    Offset="3,3" 
                                    Radius="3"/>
                        </Border.Shadow>
                    </Border>
                    <Border WidthRequest="18"
                            HeightRequest="18"
                            BackgroundColor="{Binding Source={x:Reference Name=ThisPage}, Path=SelectedFillColor, Converter={StaticResource ColorWithoutAlphaConverter}}"                              
                            StrokeThickness="0"
                            AbsoluteLayout.LayoutBounds="0, 1, AutoSize, AutoSize"
                            AbsoluteLayout.LayoutFlags="PositionProportional">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="11"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" 
                                    Opacity="0.3" 
                                    Offset="3,3" 
                                    Radius="3"/>
                        </Border.Shadow>
                    </Border>
                </AbsoluteLayout>
                <Button x:Name="AddTextBtn"
                        IsVisible="False"
                        Text="{x:Static local:MaterialIcons.Text_fields}" 
                        Style="{StaticResource ToolButtonStyle}"
                        ToolTipProperties.Text="{x:Static res:AppResources.textfeld_bearbeiten}"
                        Clicked="TextClicked"/>
                <Button x:Name="AddCloudyBtn"
                        IsVisible="False"
                        Text="{x:Static local:MaterialIcons.Cloud_off}" 
                        Style="{StaticResource ToolButtonStyle}"
                        ToolTipProperties.Text="{x:Static res:AppResources.wolkenumrandung_ein_ausschalten}"
                        Clicked="CloudyClicked"/>
                <Grid x:Name="AddMeasureBtn"
                      IsVisible="True">
                    <Button Text="{x:Static local:MaterialIcons.Straighten}"
                            Style="{StaticResource ToolButtonStyle}"        
                            ToolTipProperties.Text="{x:Static res:AppResources.bemassung_ein_ausschalten}"
                            Clicked="OnToggleMeasureClicked"/>
                    <BoxView InputTransparent="True"
                             IsVisible="{Binding IsMeasureVisible, Source={x:Reference Name=ThisPage}, Converter={StaticResource InvertedBoolConverter}}"
                             Color="{DynamicResource Primary}"
                             WidthRequest="6"
                             HeightRequest="38"
                             CornerRadius="0"
                             Rotation="-45"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"/>
                    <BoxView InputTransparent="True"
                             IsVisible="{Binding IsMeasureVisible, Source={x:Reference Name=ThisPage}, Converter={StaticResource InvertedBoolConverter}}"
                             Color="{DynamicResource PrimaryDarkText}"
                             WidthRequest="2"
                             HeightRequest="36"
                             CornerRadius="0"
                             Rotation="-45"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"/>
                </Grid>
                <Button x:Name="AddShapeBtn"
                        Text="{x:Static local:MaterialIcons.Activity_zone}"                   
                        Style="{StaticResource ToolButtonStyle}"
                        ToolTipProperties.Text="{x:Static res:AppResources.form_waehlen}"
                        Clicked="ShapeButtonClicked"/>
                <Button Text="{x:Static local:MaterialIcons.Check}"   
                        BackgroundColor="LimeGreen"
                        Style="{StaticResource ToolButtonStyle}"
                        ToolTipProperties.Text="{x:Static res:AppResources.zeichnung_speichern}"
                        Clicked="CheckClicked"/>                
            </VerticalStackLayout>
        </AbsoluteLayout>

        <AbsoluteLayout x:Name="SetPinFrame"
                        IsVisible="false"
                        InputTransparent="True"
                        CascadeInputTransparent="False">
            <Border InputTransparent="True"
                    AbsoluteLayout.LayoutBounds="0, 0, 1, 1"
                    AbsoluteLayout.LayoutFlags="All"
                    Stroke="Red"
                    StrokeThickness="16"
                    StrokeLineJoin="Miter"                    
                    Opacity="0.2"
                    ZIndex="9998"/>
            <Button AbsoluteLayout.LayoutBounds="1, 1, AutoSize, AutoSize"
                    AbsoluteLayout.LayoutFlags="PositionProportional"
                    Margin="0,0,16,16"
                    BackgroundColor="Red"
                    Text="{x:Static local:MaterialIcons.Close}"    
                    Style="{StaticResource ToolButtonStyle}"                    
                    Clicked="OnPinSetCancelClicked"
                    ZIndex="9999"/>
        </AbsoluteLayout>

        <!-- ═══ ⋮-Menü ═══ -->
        <Grid x:Name="MoreMenuOverlay"
              Grid.RowSpan="2"
              IsVisible="False"
              BackgroundColor="Transparent">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnMoreMenuDismiss" />
            </Grid.GestureRecognizers>

            <Border x:Name="MoreMenu"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    Margin="0"
                    Padding="10"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#2B2D31}">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.25" Radius="12" Offset="0,4" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>

                <VerticalStackLayout>
                    <!-- Eigenschaften -->
                    <Grid ColumnDefinitions="Auto,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSettingsTapped" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0"
                               FontSize="18"
                               VerticalTextAlignment="Center"                               
                               FontFamily="MaterialOutlined"
                               Text="{x:Static local:MaterialIcons.Edit_square}" />
                        <Label Grid.Column="1"
                               FontSize="12"
                               VerticalTextAlignment="Center"
                               Text="{x:Static res:AppResources.planeigenschaften}" />
                    </Grid>
                    <!-- Farben entfernen/hinzufügen -->
                    <Grid ColumnDefinitions="Auto,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGrayscaleClicked" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0"
                               FontSize="18"
                               VerticalTextAlignment="Center"                               
                               FontFamily="MaterialOutlined"
                               Text="{x:Static local:MaterialIcons.Invert_colors}" />
                        <Label x:Name="grayscaleButtonText"
                               Grid.Column="1"
                               FontSize="12"
                               VerticalTextAlignment="Center"
                               Text="{x:Static res:AppResources.farben_entfernen}" />
                    </Grid>

                    <BoxView HeightRequest="1"
                             Margin="0"
                             Color="{AppThemeBinding Light=#1F000000, Dark=#33FFFFFF}"/>

                    <!-- Löschen (destruktiv, rot) -->
                    <Grid ColumnDefinitions="Auto,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMenuDeleteTapped" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0"
                               FontSize="18"
                               VerticalTextAlignment="Center"                               
                               FontFamily="MaterialOutlined"
                               Text="{x:Static local:MaterialIcons.Delete}"
                               TextColor="{AppThemeBinding Light=#B3261E, Dark=#F2B8B5}" />
                        <Label Grid.Column="1"
                               FontSize="12"
                               VerticalTextAlignment="Center"
                               Text="{x:Static res:AppResources.plan_loeschen}"
                               TextColor="{AppThemeBinding Light=#B3261E, Dark=#F2B8B5}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
