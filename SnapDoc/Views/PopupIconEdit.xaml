<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/maui/global"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:views="clr-namespace:SnapDoc.Views"               
               xmlns:services="clr-namespace:SnapDoc.Services"
               xmlns:controls="clr-namespace:SnapDoc.Controls"
               xmlns:res="clr-namespace:SnapDoc.Resources.Languages"
               xmlns:local="clr-namespace:SnapDoc"
               BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryBackground}, Dark={DynamicResource PrimaryBackgroundDark}}"
               HorizontalOptions="Center"
               x:TypeArguments="x:String"
               x:Class="SnapDoc.Views.PopupIconEdit">

    <Grid x:DataType="views:PopupIconEdit"
          Padding="6"
          WidthRequest="320"
          RowDefinitions="*, Auto">
        <ScrollView Grid.Row="0" VerticalOptions="Start" MaximumHeightRequest="800">
            <VerticalStackLayout Margin="0,0,0,6">
                <Grid ColumnDefinitions="Auto, *">
                    <AbsoluteLayout Grid.Column="0"
                                    WidthRequest="{Binding IconPreviewWidth, Converter={StaticResource MathExpressionConverter}, ConverterParameter='x+24'}"
                                    HeightRequest="{Binding IconPreviewHeight, Converter={StaticResource MathExpressionConverter}, ConverterParameter='x+24'}">
                        <Image x:Name="iconImage"
                               Margin="12"
                               WidthRequest="{Binding IconPreviewWidth}"
                               HeightRequest="{Binding IconPreviewHeight}"
                               Aspect="AspectFit"/>

                        <Label x:Name="blinkingLabel"
                               FontFamily="MaterialOutlined"
                               Text="{x:Static local:MaterialIcons.Point_scan}"
                               FontSize="24"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"
                               WidthRequest="24"
                               HeightRequest="24"
                               TranslationX="{Binding TransX}"
                               TranslationY="{Binding TransY}">
                        </Label>
                    </AbsoluteLayout>
                    <VerticalStackLayout Grid.Column="1">
                        <controls:BorderedEntry
                            Text="{Binding Anchor_X_Text}"
                            Placeholder="{x:Static res:AppResources.anker_x}"
                            BackgroundColor="Transparent"
                            Keyboard="Numeric"
                            BorderColor="{DynamicResource SecondaryBackground}"
                            PlaceholderColor="{DynamicResource SecondaryBackground}"
                            FocusedBorderColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"/>

                        <controls:BorderedEntry
                            Text="{Binding Anchor_Y_Text}"
                            Placeholder="{x:Static res:AppResources.anker_y}"
                            BackgroundColor="Transparent"
                            Keyboard="Numeric"
                            BorderColor="{DynamicResource SecondaryBackground}"
                            PlaceholderColor="{DynamicResource SecondaryBackground}"
                            FocusedBorderColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"/>
                    </VerticalStackLayout>
                </Grid>

                <controls:BorderedEntry
                    x:Name="iconName"
                    Placeholder="{x:Static res:AppResources.bezeichnung}"
                    BackgroundColor="Transparent"
                    Keyboard="Numeric"
                    BorderColor="{DynamicResource SecondaryBackground}"
                    PlaceholderColor="{DynamicResource SecondaryBackground}"
                    FocusedBorderColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"/>

                <VerticalStackLayout Spacing="2">
                    <Grid RowDefinitions="Auto, Auto">
                        <!-- Input-Feld -->
                        <controls:BorderedEntry x:Name="iconCategory"
                               Grid.Row="0"
                               TextChanged="OnCategoryTextChanged"
                               TextColor="{AppThemeBinding Light={DynamicResource PrimaryText}, Dark={DynamicResource PrimaryDarkText}}"
                               Placeholder="{x:Static res:AppResources.kategorie}"
                               BorderColor="{DynamicResource SecondaryBackground}"
                               PlaceholderColor="{DynamicResource SecondaryBackground}"
                               FocusedBorderColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"/>

                        <!-- Schwebender Container fuer die Vorschlaege -->
                        <Border Grid.Row="1"
                                IsVisible="{Binding IsCategorySuggestionsVisible}"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#2B2B2B}"
                                Stroke="{DynamicResource SecondaryBackground}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Margin="0,4,0,0"
                                ZIndex="99">
                            <Border.Shadow>
                                <Shadow Brush="Black"
                                        Offset="0,4"
                                        Radius="8"
                                        Opacity="0.25" />
                            </Border.Shadow>

                            <CollectionView x:Name="CategorySuggestionsView"
                                            ItemsSource="{Binding FilteredCategories}"
                                            SelectionMode="Single"
                                            SelectionChanged="OnCategorySelectionChanged"
                                            MaximumHeightRequest="160">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid Padding="12,10">
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroupList>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualState x:Name="Normal" />
                                                        <VisualState x:Name="PointerOver">
                                                            <VisualState.Setters>
                                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#EFEFEF, Dark=#3D3D3D}" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateGroupList>
                                            </VisualStateManager.VisualStateGroups>

                                            <Label Text="{Binding .}" 
                                                   TextColor="{AppThemeBinding Light={DynamicResource PrimaryText}, Dark={DynamicResource PrimaryDarkText}}"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <Button Text="{x:Static res:AppResources.farbe_waehlen}"
                        BorderWidth="1"
                        BorderColor="Black"
                        BackgroundColor="{Binding SelectedColor}"
                        TextColor="{Binding SelectedColor, Converter={StaticResource ColorToColorForTextConverter}}"
                        Clicked="OnColorPickerClicked"/>

                <VerticalStackLayout>
                    <controls:RangeSlider
                         LabelText="{x:Static res:AppResources.voreinstellung_skalierung}"
                         IsRange="False"
                         Minimum="0"
                         Maximum="1"
                         Step="0.01"
                         ValueFontSize="12"
                         TextColor="{AppThemeBinding Light={DynamicResource PrimaryText}, Dark={DynamicResource PrimaryDarkText}}"
                         MinimumValueDisplayFormat="{}{0:0} %"
                         LabelCalculation="*100"
                         LowerValue="{Binding IconScale}"
                         MinimumTrackColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDarkAccent}}"
                         MaximumTrackColor="{AppThemeBinding Light=LightGray, Dark=Gray}">
                    </controls:RangeSlider>
                    <controls:Switch x:Name="allowRotate"
                                    LabelText="{x:Static res:AppResources.rotation_sperren}"
                                    TextColor="{AppThemeBinding Light={DynamicResource PrimaryText}, Dark={DynamicResource PrimaryDarkText}}"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center"
                                    BorderColorOff="Transparent"
                                    KnobColorOn="White"
                                    KnobColorOff="White"
                                    SwitchColorOn="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"
                                    SwitchColorOff="{AppThemeBinding Light=LightGray, Dark=Gray}"/>

                    <controls:Switch x:Name="allowAutoScale"
                                    LabelText="{x:Static res:AppResources.auto_skalierung_sperren}"
                                    TextColor="{AppThemeBinding Light={DynamicResource PrimaryText}, Dark={DynamicResource PrimaryDarkText}}"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center"
                                    BorderColorOff="Transparent"
                                    KnobColorOn="White"
                                    KnobColorOff="White"
                                    SwitchColorOn="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"
                                    SwitchColorOff="{AppThemeBinding Light=LightGray, Dark=Gray}"/>

                    <controls:Switch x:Name="deleteIcon"
                                    LabelText="{x:Static res:AppResources.icon_loeschen}"
                                    TextColor="{AppThemeBinding Light={DynamicResource PrimaryText}, Dark={DynamicResource PrimaryDarkText}}"
                                    IsVisible="False"
                                    IsToggled="False"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center"
                                    BorderColorOff="Transparent"
                                    KnobColorOn="White"
                                    KnobColorOff="White"
                                    SwitchColorOn="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"
                                    SwitchColorOff="{AppThemeBinding Light=LightGray, Dark=Gray}"/>

                    <controls:Switch x:Name="setDefault"
                                    LabelText="{x:Static res:AppResources.standard_icon}"
                                    TextColor="{AppThemeBinding Light={DynamicResource PrimaryText}, Dark={DynamicResource PrimaryDarkText}}"
                                    IsToggled="False"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center"
                                    BorderColorOff="Transparent"
                                    KnobColorOn="White"
                                    KnobColorOff="White"
                                    SwitchColorOn="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"
                                    SwitchColorOff="{AppThemeBinding Light=LightGray, Dark=Gray}"/>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" ColumnDefinitions="*, *">
            <Button Grid.Column="0"
                    x:Name="cancelButtonText"
                    Text="{x:Static res:AppResources.abbrechen}"
                    BackgroundColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"
                    TextColor="{DynamicResource PrimaryDarkText}"
                    Clicked="OnCancelClicked" />
            <Button Grid.Column="1"
                    x:Name="okButtonText"
                    Text="{x:Static res:AppResources.ok}"
                    BackgroundColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"
                    TextColor="{DynamicResource PrimaryDarkText}"
                    Clicked="OnOkClicked" />
        </Grid>
    </Grid>
</toolkit:Popup>
