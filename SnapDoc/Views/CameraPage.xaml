<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:res="clr-namespace:SnapDoc.Resources.Languages"
             xmlns:controls="clr-namespace:SnapDoc.Controls"
             xmlns:views="clr-namespace:SnapDoc.Views"
             xmlns:local="clr-namespace:SnapDoc"
             x:Class="SnapDoc.Views.CameraPage"
             x:DataType="views:CameraPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="Black">

    <Grid RowDefinitions="56,*" BackgroundColor="Black">
        <Grid Grid.Row="0"
              Padding="8,0"
              ZIndex="10">

            <Button x:Name="closeButton"
                    Text="{x:Static local:MaterialIcons.Close}"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"
                    HeightRequest="44"
                    WidthRequest="44"
                    Padding="0"
                    FontSize="26"
                    FontFamily="MaterialOutlined"
                    TextColor="White"
                    BackgroundColor="Transparent"
                    Clicked="OnCloseClicked" />

            <Button x:Name="flashButton"
                    Text="{x:Static local:MaterialIcons.Flash_auto}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    HeightRequest="44"
                    WidthRequest="44"
                    Padding="{OnPlatform Default=0, iOS=5}"
                    FontSize="26"
                    FontFamily="MaterialOutlined"
                    TextColor="White"
                    BackgroundColor="Transparent"
                    Clicked="OnFlashButtonClicked" />

            <HorizontalStackLayout x:Name="ratioContainer"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center"
                                   Spacing="4">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="views:CameraRatio">
                        <Button Text="{Binding Name}"
                                CommandParameter="{Binding Value}"
                                Clicked="OnRatioClicked"
                                WidthRequest="48"
                                HeightRequest="36"
                                Padding="0"
                                FontSize="14"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                BackgroundColor="Transparent"
                                TextColor="White" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </Grid>
        <Grid Grid.Row="1" x:Name="previewArea">
            <Grid x:Name="previewHost"
                  HorizontalOptions="Center"
                  VerticalOptions="Start">

                <Grid x:Name="cameraFrame"
                      IsClippedToBounds="True"
                      HorizontalOptions="Center"
                      VerticalOptions="Center">
                    <toolkit:CameraView x:Name="cameraView"
                                        MediaCaptured="OnMediaCaptured"
                                        MediaCaptureFailed="OnMediaCaptureFailed">
                        <toolkit:CameraView.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnContainerTapped" />
                        </toolkit:CameraView.GestureRecognizers>
                    </toolkit:CameraView>
                </Grid>

                <Image x:Name="previewImage"
                       IsVisible="False"
                       BackgroundColor="Black"
                       Aspect="AspectFit" />

                <controls:VerticalZoomSlider x:Name="customZoomSlider"
                                             VerticalOptions="Center"
                                             HorizontalOptions="End"
                                             Margin="0,0,16,0"
                                             IsVisible="False"
                                             Opacity="0"
                                             Minimum="1"
                                             Maximum="10"
                                             TrackColor="Gray"
                                             ActiveTrackColor="Gray"
                                             ThumbColor="Yellow"
                                             TextColor="Yellow"
                                             ThumbRadius="10"
                                             TrackWidth="5"
                                             FontSize="16"
                                             IsFontBold="False"
                                             HeightRequest="280"
                                             WidthRequest="80"
                                             ValueChanged="OnZoomSliderValueChanged" />
                <Grid x:Name="liveButtons"
                      VerticalOptions="End"
                      Margin="0,0,0,24"
                      ColumnDefinitions="*,Auto,*">

                    <Button Grid.Column="1"
                            x:Name="controlButton"
                            HeightRequest="76"
                            WidthRequest="76"
                            CornerRadius="38"
                            Padding="0"
                            Text=""
                            BackgroundColor="Transparent"
                            BorderColor="White"
                            BorderWidth="5"
                            Clicked="OnCaptureClicked">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="Scale" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Property="Scale" Value="0.9" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </VisualStateManager.VisualStateGroups>
                    </Button>

                    <Button Grid.Column="2"
                            x:Name="switchCameraButton"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            HeightRequest="52"
                            WidthRequest="52"
                            CornerRadius="26"
                            Padding="{OnPlatform Default=0, iOS=5}"
                            Text="{x:Static local:MaterialIcons.Flip_camera_ios}"
                            FontSize="26"
                            FontFamily="MaterialOutlined"
                            TextColor="White"
                            BackgroundColor="#404040"
                            Opacity="0.6"
                            Clicked="OnSwitchCameraClicked" />
                </Grid>

                <Grid x:Name="previewButtons"
                      IsVisible="False"
                      VerticalOptions="End"
                      HorizontalOptions="Center"
                      Margin="0,0,0,24"
                      ColumnDefinitions="Auto,Auto"
                      ColumnSpacing="40">
                    <Button Grid.Column="0"
                            Text="{x:Static local:MaterialIcons.Close}"
                            FontSize="30"
                            FontFamily="MaterialOutlined"
                            Padding="0"
                            HeightRequest="52"
                            WidthRequest="80"
                            Clicked="OnRetakeClicked"
                            BackgroundColor="#E53935"
                            TextColor="White" />
                    <Button Grid.Column="1"
                            Text="{x:Static local:MaterialIcons.Save}"
                            FontSize="30"
                            FontFamily="MaterialOutlined"
                            Padding="0"
                            HeightRequest="52"
                            WidthRequest="80"
                            Clicked="OnConfirmClicked"
                            BackgroundColor="#43A047"
                            TextColor="White" />
                </Grid>
            </Grid>
        </Grid>

        <BoxView x:Name="flashOverlay"
                 Grid.RowSpan="2"
                 BackgroundColor="White"
                 Opacity="0"
                 IsVisible="False"
                 InputTransparent="True" />
    </Grid>
</ContentPage>
