<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:views="clr-namespace:SnapDoc.Views"
             xmlns:services="clr-namespace:SnapDoc.Services"
             xmlns:controls="clr-namespace:SnapDoc.Controls"
             xmlns:res="clr-namespace:SnapDoc.Resources.Languages"
             xmlns:local="clr-namespace:SnapDoc"
             Shell.TitleColor="{DynamicResource PrimaryDark}"
             Shell.BackgroundColor="{DynamicResource SecondaryBackgroundDark}"
             BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryBackground}, Dark={DynamicResource PrimaryBackgroundDark}}"
             x:Class="SnapDoc.Views.ProjectDetails"
             x:Name="ThisPage"
             Title="{x:Static res:AppResources.projektverwaltung}">

    <!-- Titelleiste nur noch mit Titel - die Bildaktionen sitzen auf dem Bild -->
    <Shell.TitleView>
        <Grid>
            <Label x:DataType="views:ProjectDetails"
                   Text="{Binding Title, Source={x:Reference Name=ThisPage}}"
                   TextColor="{DynamicResource PrimaryDark}"
                   BackgroundColor="Transparent"
                   FontSize="18"
                   VerticalOptions="Center"
                   HorizontalOptions="Start"/>
        </Grid>
    </Shell.TitleView>

    <Grid x:DataType="local:ProjectItem"
          BindingContext="{x:Static local:ProjectItem.Current}"
          RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Headerbild: immer sichtbar, ohne eigenes Bild mit Platzhalter banner.jpg -->
        <Grid Grid.Row="0"
              HeightRequest="100">

            <ImageButton Source="{Binding TitleImageFullSource}"
                         Aspect="AspectFill"
                         HorizontalOptions="Fill"
                         VerticalOptions="Fill"
                         CornerRadius="0"
                         Clicked="OnImageTapped">
                <ImageButton.Triggers>
                    <!-- Kein eigenes Bild: Platzhalter statt TitleImageFullSource -->
                    <DataTrigger TargetType="ImageButton"
                                 Binding="{Binding HasTitleImage}"
                                 Value="False">
                        <Setter Property="Source" Value="banner.jpg" />
                    </DataTrigger>
                </ImageButton.Triggers>
            </ImageButton>

            <!-- Abdunklung bei offenem Menue; Tippen schliesst -->
            <Grid x:Name="titleMenuScrim"
                  IsVisible="False"
                  Opacity="0"
                  BackgroundColor="#66000000">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTitleMenuScrimTapped" />
                </Grid.GestureRecognizers>
            </Grid>

            <!-- Papierkorb oben links, nur bei eigenem Bild (wird im Code gesetzt) -->
            <Border x:Name="titleRemoveChip"
                    IsVisible="False"
                    Opacity="0"
                    StrokeShape="RoundRectangle 18"
                    Stroke="#B3FFFFFF"
                    StrokeThickness="1"
                    BackgroundColor="#E53935"
                    HeightRequest="36"
                    WidthRequest="36"
                    HorizontalOptions="Start"
                    VerticalOptions="Start"
                    Margin="12,12,0,0"
                    ToolTipProperties.Text="{x:Static res:AppResources.titelbild_entfernen}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTitleRemoveTapped" />
                </Border.GestureRecognizers>
                <Label Text="{x:Static local:MaterialIcons.Delete}"
                       FontFamily="MaterialOutlined"
                       FontSize="18"
                       TextColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Border>

            <!-- Aktionen uebereinander links vom Stift, gleich breit -->
            <VerticalStackLayout x:Name="titleMenu"
                                 IsVisible="False"
                                 Spacing="6"
                                 HorizontalOptions="End"
                                 VerticalOptions="End"
                                 Margin="0,0,56,12">

                <Border StrokeShape="RoundRectangle 18"
                        Stroke="#B3FFFFFF"
                        StrokeThickness="1"
                        BackgroundColor="#80000000"
                        HeightRequest="36"
                        HorizontalOptions="Fill"
                        Padding="12,0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTitleCameraTapped" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Label Text="{x:Static local:MaterialIcons.Photo_camera}"
                               FontFamily="MaterialOutlined"
                               FontSize="18"
                               TextColor="White"
                               VerticalOptions="Center"/>
                        <Label Text="{x:Static res:AppResources.titelbild_kamera}"
                               FontSize="14"
                               TextColor="White"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <Border StrokeShape="RoundRectangle 18"
                        Stroke="#B3FFFFFF"
                        StrokeThickness="1"
                        BackgroundColor="#80000000"
                        HeightRequest="36"
                        HorizontalOptions="Fill"
                        Padding="12,0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTitleFileTapped" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Label Text="{x:Static local:MaterialIcons.Image_search}"
                               FontFamily="MaterialOutlined"
                               FontSize="18"
                               TextColor="White"
                               VerticalOptions="Center"/>
                        <Label Text="{x:Static res:AppResources.titelbild_datei}"
                               FontSize="14"
                               TextColor="White"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Stift / X -->
            <Button x:Name="titleEditButton"
                    Text="{x:Static local:MaterialIcons.Edit}"
                    FontFamily="MaterialOutlined"
                    FontSize="18"
                    TextColor="White"
                    BackgroundColor="#80000000"
                    BorderColor="#B3FFFFFF"
                    BorderWidth="1"
                    WidthRequest="36"
                    HeightRequest="36"
                    MinimumWidthRequest="36"
                    MinimumHeightRequest="36"
                    CornerRadius="18"
                    Padding="0"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    Margin="0,0,12,12"
                    ToolTipProperties.Text="{x:Static res:AppResources.titelbild}"
                    Clicked="OnTitleEditClicked"/>
        </Grid>

        <ScrollView Grid.Row="1" Margin="16">
            <VerticalStackLayout Spacing="6">
                <controls:BorderedEntry
                    Text="{Binding ObjectName, Mode=TwoWay}"
                    Placeholder="{x:Static res:AppResources.objektbezeichnung}"
                    BackgroundColor="Transparent"
                    BorderColor="{DynamicResource SecondaryBackground}"
                    PlaceholderColor="{DynamicResource SecondaryBackground}"
                    FocusedBorderColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"/>

                <controls:BorderedEntry
                    Text="{Binding ClientName, Mode=TwoWay}"
                    Placeholder="{x:Static res:AppResources.kunde_bauherrschaft}"
                    BackgroundColor="Transparent"
                    BorderColor="{DynamicResource SecondaryBackground}"
                    PlaceholderColor="{DynamicResource SecondaryBackground}"
                    FocusedBorderColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"/>

                <controls:BorderedEditor
                    Text="{Binding ObjectAddress, Mode=TwoWay}"
                    Placeholder="{x:Static res:AppResources.adresse}"
                    BackgroundColor="Transparent"
                    BorderColor="{DynamicResource SecondaryBackground}"
                    PlaceholderColor="{DynamicResource SecondaryBackground}"
                    FocusedBorderColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"/>

                <controls:BorderedEntry
                    Text="{Binding WorkingTitle, Mode=TwoWay}"
                    Placeholder="{x:Static res:AppResources.projektvorgang}"
                    BackgroundColor="Transparent"
                    BorderColor="{DynamicResource SecondaryBackground}"
                    PlaceholderColor="{DynamicResource SecondaryBackground}"
                    FocusedBorderColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"/>

                <controls:BorderedEntry
                    Text="{Binding ProjectNr, Mode=TwoWay}"
                    Placeholder="{x:Static res:AppResources.projektnummer}"
                    BackgroundColor="Transparent"
                    BorderColor="{DynamicResource SecondaryBackground}"
                    PlaceholderColor="{DynamicResource SecondaryBackground}"
                    FocusedBorderColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"/>

                <controls:BorderedEntry
                    Text="{Binding ProjectManager, Mode=TwoWay}"
                    Placeholder="{x:Static res:AppResources.projektleitung}"
                    BackgroundColor="Transparent"
                    BorderColor="{DynamicResource SecondaryBackground}"
                    PlaceholderColor="{DynamicResource SecondaryBackground}"
                    FocusedBorderColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"/>

                <Button
                    Text="{Binding CreationDateDisplay}"
                    Margin="0,8,0,0"
                    HeightRequest="44"
                    FontSize="{StaticResource AppFontSizeNormal}"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"
                    BackgroundColor="Transparent"
                    BorderColor="{DynamicResource SecondaryBackground}"
                    BorderWidth="1"
                    TextColor="{AppThemeBinding Light={DynamicResource PrimaryText}, Dark={DynamicResource PrimaryDarkText}}"
                    ImageSource="{FontImageSource FontFamily=MaterialOutlined, Size=24, Color={AppThemeBinding Light={DynamicResource PrimaryText}, Dark={DynamicResource PrimaryDarkText}}, Glyph={x:Static local:MaterialIcons.Calendar_month}}"
                    Clicked="CalendarClicked"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
