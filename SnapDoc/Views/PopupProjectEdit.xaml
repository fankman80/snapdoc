<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/maui/global"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:controls="clr-namespace:SnapDoc.Controls"
               xmlns:services="clr-namespace:SnapDoc.Services"
               xmlns:res="clr-namespace:SnapDoc.Resources.Languages"
               xmlns:local="clr-namespace:SnapDoc"
               BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryBackground}, Dark={DynamicResource PrimaryBackgroundDark}}"
               HorizontalOptions="Center"
               x:TypeArguments="x:String"
               x:Class="SnapDoc.Views.PopupProjectEdit">

    <Grid Padding="6"
          WidthRequest="320">
        <VerticalStackLayout HorizontalOptions="Fill">
            <Button Text="{x:Static res:AppResources.zip_exportieren}"
                    Padding="0"
                    BackgroundColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"
                    TextColor="{DynamicResource PrimaryDarkText}"
                    ImageSource="{FontImageSource FontFamily=MaterialOutlined, Color={DynamicResource PrimaryDarkText}, Glyph={x:Static local:MaterialIcons.Folder_zip}}"
                    ToolTipProperties.Text="{x:Static res:AppResources.als_zip_exportieren}"
                    Clicked="OnSaveClicked" />

            <Button x:Name="openFolderBtn"
                    Padding="0"
                    IsVisible="{OnPlatform Default=False, WinUI=True, iOS=False, Android=False}"
                    Text="{x:Static res:AppResources.verzeichnis_oeffnen}"
                    BackgroundColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"
                    TextColor="{DynamicResource PrimaryDarkText}"
                    ImageSource="{FontImageSource FontFamily=MaterialOutlined, Color={DynamicResource PrimaryDarkText}, Glyph={x:Static local:MaterialIcons.Folder_open}}"
                    Clicked="OnOpenFolderClicked"/>

            <Button x:Name="UploadButton"
                    Padding="0"
                    Text="{x:Static res:AppResources.in_cloud_hochladen}"
                    BackgroundColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"
                    TextColor="{DynamicResource PrimaryDarkText}"
                    ImageSource="{FontImageSource FontFamily=MaterialOutlined, Color={DynamicResource PrimaryDarkText}, Glyph={x:Static local:MaterialIcons.Cloud_upload}}"
                    ToolTipProperties.Text="{x:Static res:AppResources.auf_sharepoint_oder_onedrive_hochladen}"
                    Clicked="OnCloudPickerClicked"/>

            <Grid ColumnDefinitions="*,*">
                <Button Grid.Column="1"
                        HorizontalOptions="Fill"
                        x:Name="cancelButtonText"
                        Text="{x:Static res:AppResources.abbrechen}"
                        BackgroundColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"
                        TextColor="{DynamicResource PrimaryDarkText}"
                        Clicked="OnCancelClicked" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</toolkit:Popup>
