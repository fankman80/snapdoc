<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns:res="clr-namespace:SnapDoc.Resources.Languages"
               BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryBackground}, Dark={DynamicResource PrimaryBackgroundDark}}"
               HorizontalOptions="Center"
               x:Class="SnapDoc.Views.PopupAlert">

    <Grid WidthRequest="320">
        <VerticalStackLayout Spacing="8">
            <Label x:Name="titleHeader"
                   FontAttributes="Bold"
                   HorizontalOptions="Start"/>
            <Line x:Name="headerLine" Stroke="{AppThemeBinding Light=LightSlateGray, Dark=LightGray}" X2="500" />
            <Label x:Name="titleText"
                   HorizontalOptions="Start"/>
            <Button Grid.Column="1"
                    MinimumWidthRequest="100"
                    x:Name="okButtonText"
                    Text="{x:Static res:AppResources.ok}"
                    BackgroundColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"
                    TextColor="{DynamicResource PrimaryDarkText}"
                    Clicked="OnOkClicked" />            
        </VerticalStackLayout>
    </Grid>
</toolkit:Popup>
