<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns:views="clr-namespace:SnapDoc.Views"
             xmlns:services="clr-namespace:SnapDoc.Services"
             xmlns:controls="clr-namespace:SnapDoc.Controls"
             xmlns:res="clr-namespace:SnapDoc.Resources.Languages"
             xmlns:local="clr-namespace:SnapDoc"
             x:Name="ThisPage"
             x:Class="SnapDoc.Views.PinList"
             Shell.TitleColor="{DynamicResource PrimaryDark}"
             Shell.BackgroundColor="{DynamicResource SecondaryBackgroundDark}"
             BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryBackground}, Dark={DynamicResource PrimaryBackgroundDark}}"
             Title="{x:Static res:AppResources.pins}">

    <Shell.TitleView>
        <HorizontalStackLayout Spacing="0">
            <Label x:DataType="views:PinList"
                   Text="{Binding Title, Source={x:Reference Name=ThisPage}}"
                   TextColor="{DynamicResource PrimaryDark}"
                   Background="Transparent"
                   BackgroundColor="Transparent"
                   FontSize="18"
                   VerticalOptions="Center"
                   HorizontalOptions="Start"/>
        </HorizontalStackLayout>
    </Shell.TitleView>

    <Grid RowSpacing="10" Margin="16,10,16,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" HorizontalOptions="Start"
                MinimumWidthRequest="140"
                Padding="0"
                HeightRequest="38"
                MinimumHeightRequest="38"
                StrokeThickness="1"
                Stroke="{DynamicResource Primary}"
                StrokeShape="RoundRectangle 4">
            <local:BorderlessEntry x:Name="SearchEntry"
                                   Margin="6,0,0,0"
                                   FontSize="11"
                                   FontFamily="{x:StaticResource AppFontFamily}"
                                   VerticalTextAlignment="Center"
                                   VerticalOptions="Center"
                                   Placeholder="{x:Static res:AppResources.suche}"
                                   TextChanged="SearchEntry_TextChanged"
                                   BackgroundColor="Transparent"
                                   TextColor="{AppThemeBinding Light={DynamicResource PrimaryText}, Dark={DynamicResource PrimaryDarkText}}"/>
        </Border>
        <HorizontalStackLayout Grid.Row="0" HorizontalOptions="End">
            <controls:CustomRadioPicker x:Name="SortPicker"
                                        x:DataType="services:SettingsService" BindingContext="{x:Static services:SettingsService.Instance}"
                                        ControlPadding="6,0,10,0"
                                        HeightRequest="38"
                                        MinimumHeightRequest="38"
                                        FontSize="11"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Center"
                                        CornerRadius="4"
                                        BorderColor="{DynamicResource Primary}"
                                        ItemsSource="{Binding PinSortCrits}"
                                        SelectedItem="{Binding PinSortCrit}"/>
            <Button x:Name="SortDirection"
                    CornerRadius="4"
                    Padding="0"
                    HeightRequest="38"
                    WidthRequest="38"
                    MinimumHeightRequest="38"
                    MinimumWidthRequest="38"
                    HorizontalOptions="End"
                    VerticalOptions="Center"
                    BorderColor="{DynamicResource Primary}"
                    BorderWidth="1"
                    BackgroundColor="Transparent"
                    Clicked="OnSortDirectionClicked">
                <Button.ImageSource>
                    <FontImageSource FontFamily="MaterialOutlined"
                                     Color="{DynamicResource Primary}"
                                     Glyph="{x:Static local:MaterialIcons.Sort}" />
                </Button.ImageSource>
            </Button>
        </HorizontalStackLayout>

        <Grid Grid.Row="1">
            <CollectionView x:DataType="views:PinList"
                            ItemsSource="{Binding DisplayPins}"
                            SelectionMode="None"
                            ItemsUpdatingScrollMode="KeepItemsInView">
                <!-- LinearItemsLayout statt GridItemsLayout: unter Windows erhalten sonst alle Karten dieselbe Höhe -->
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="6"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:PinItem">
                        <Border Opacity="{Binding DisplayOpacity}"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDarkAccent}}"
                                StrokeShape="RoundRectangle 4">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEditClicked" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="60,*,44,44"
                                  RowDefinitions="Auto,Auto,Auto,*"
                                  RowSpacing="0" ColumnSpacing="0">
                                <Label Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2"
                                       Margin="8,4,0,0"
                                       FontAttributes="Bold"
                                       FontSize="12"
                                       Text="{Binding PlanDisplay}"
                                       MaxLines="1"
                                       LineBreakMode="TailTruncation"/>

                                <Label Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2"
                                       Margin="8,0,0,0"
                                       FontSize="12"
                                       Text="{Binding PinName}"
                                       MaxLines="1"
                                       LineBreakMode="TailTruncation"/>

                                <BoxView Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="4"
                                         Color="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDarkAccent}}"
                                         HeightRequest="1"
                                         Margin="10,0,10,0"/>

                                <!-- Inhalt: Icon links, rechts Beschreibung / Name / Datum, Badge unten rechts -->
                                <Grid Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="4"
                                      ColumnDefinitions="56,*,Auto"
                                      RowDefinitions="Auto,Auto,*"
                                      VerticalOptions="Fill"
                                      ColumnSpacing="8"
                                      RowSpacing="2"
                                      Margin="4,6,10,6">

                                    <!-- Icon: über alle Textzeilen, vertikal zentriert -->
                                    <Image Grid.Column="0" Grid.Row="0" Grid.RowSpan="3"
                                           WidthRequest="44"
                                           HeightRequest="44"
                                           VerticalOptions="Start"
                                           HorizontalOptions="Center"
                                           ClassId="{Binding SelfId}"
                                           AutomationId="{Binding OnPlanId}"
                                           Source="{Binding DisplayIconPath}"
                                           Aspect="AspectFit">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnPinIconClicked"/>
                                        </Image.GestureRecognizers>
                                    </Image>

                                    <!-- 1. Beschreibung: max. 3 Zeilen, ausgeblendet wenn leer -->
                                    <Label Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="2"
                                           IsVisible="{Binding PinDesc, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
                                           Text="{Binding PinDesc}"
                                           FontSize="12"
                                           MaxLines="3"
                                           LineBreakMode="TailTruncation"
                                           Margin="0,0,0,2"/>

                                    <!-- 2. Ersteller: ausgeblendet wenn leer -->
                                    <HorizontalStackLayout Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2"
                                                           Spacing="4"
                                                           IsVisible="{Binding CreatedBy, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
                                                           VerticalOptions="End">
                                        <Label Text="{x:Static local:MaterialIcons.Person}"
                                               FontFamily="MaterialOutlined"
                                               FontSize="14"
                                               VerticalTextAlignment="Center"/>
                                        <Label Text="{Binding CreatedBy}"
                                               FontSize="11"
                                               MaxLines="1"
                                               LineBreakMode="TailTruncation"
                                               VerticalTextAlignment="Center"/>
                                    </HorizontalStackLayout>

                                    <!-- 3. Datum / Zeit: unterste Zeile, an den unteren Rand gedrückt -->
                                    <HorizontalStackLayout Grid.Column="1" Grid.Row="2"
                                                           Spacing="4"
                                                           VerticalOptions="End">
                                        <Label Text="{x:Static local:MaterialIcons.Schedule}"
                                               FontFamily="MaterialOutlined"
                                               FontSize="14"
                                               VerticalTextAlignment="Center"/>
                                        <Label Text="{Binding Time, StringFormat='{0: dd.MM.yyyy | HH:mm}'}"
                                               FontSize="11"
                                               VerticalTextAlignment="Center"/>
                                    </HorizontalStackLayout>

                                    <!-- Badge: immer unten rechts, ausgeblendet wenn "" -->
                                    <Border Grid.Column="2" Grid.Row="2"
                                            IsVisible="{Binding PriorityKey, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
                                            Padding="6,2,6,2"
                                            HorizontalOptions="End"
                                            VerticalOptions="End"
                                            StrokeThickness="0"
                                            BackgroundColor="{Binding PriorityColor}"
                                            StrokeShape="RoundRectangle 10">
                                        <Label Text="{Binding PriorityKey}"
                                               FontSize="11"
                                               MaxLines="1"
                                               TextColor="{Binding PriorityColor, Converter={StaticResource ColorToColorForTextConverter}}"/>
                                    </Border>
                                </Grid>

                                <Button Grid.Column="2" Grid.Row="0" Grid.RowSpan="2"
                                        IsVisible="{Binding IsWebMapPin}"
                                        Padding="{OnPlatform Default=0, WinUI=0, iOS=4, Android=0}"
                                        ClassId="{Binding SelfId}"
                                        AutomationId="{Binding OnPlanId}"
                                        Text="{x:Static local:MaterialIcons.Globe_location_pin}"
                                        FontSize="30"
                                        FontFamily="MaterialOutlined"
                                        BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDarkAccent}}"
                                        ToolTipProperties.Text="{x:Static res:AppResources.pin_auf_karte_anzeigen}"
                                        Clicked="OnPinClicked"/>

                                <Button Grid.Column="2" Grid.Row="0" Grid.RowSpan="2"
                                        IsVisible="{Binding IsWebMapPin, Converter={StaticResource InvertedBoolConverter}}"
                                        Padding="{OnPlatform Default=0, WinUI=0, iOS=4, Android=0}"
                                        ClassId="{Binding SelfId}"
                                        AutomationId="{Binding OnPlanId}"
                                        Text="{x:Static local:MaterialIcons.Recenter}"
                                        FontSize="30"
                                        FontFamily="MaterialOutlined"
                                        BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDarkAccent}}"
                                        ToolTipProperties.Text="{x:Static res:AppResources.auf_pin_zentrieren}"
                                        Clicked="OnPinClicked"/>

                                <Button Grid.Column="3" Grid.Row="0" Grid.RowSpan="2"
                                        Padding="{OnPlatform Default=0, WinUI=0, iOS=4, Android=0}"
                                        Text="{Binding IsAllowExport, Converter={StaticResource ExportToGlyphConverter}}"
                                        FontSize="30"
                                        FontFamily="MaterialOutlined"
                                        BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDarkAccent}}"
                                        ToolTipProperties.Text="{x:Static res:AppResources.pin_exportieren}"
                                        Clicked="OnAllowExportClicked"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
        <Label Grid.Row="2"
               x:Name="PinCounterLabel"
               FontSize="12"/>
    </Grid>
</ContentPage>
