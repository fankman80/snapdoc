<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" android:versionName="2.5.0" android:versionCode="461">
	<!-- Berechtigungen -->
	<!-- Package Visibility für Kamera -->
	<queries>
		<intent>
			<action android:name="android.media.action.IMAGE_CAPTURE" />
		</intent>
	</queries>
	<!-- App-Block -->
	<!-- Kamera & Internet -->
	<uses-permission android:name="android.permission.CAMERA" />
	<uses-permission android:name="android.permission.INTERNET" />
	<!-- Standort -->
	<uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
	<uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
	<!-- EXIF-Standortdaten aus ausgewaehlten Fotos auslesen (Android 10+) -->
	<uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
	<!-- Galerie-Lesezugriff fuer neuere Android-Versionen (Android 13+) -->
	<uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
	<!-- Abwaertskompatibilitaet fuer aeltere Android-Versionen -->
	<uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
	<uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
	<application android:allowBackup="true" android:supportsRtl="true" android:label="SnapDoc" android:icon="@mipmap/appicon" />
</manifest>